# ── Git helpers ─────────────────────────────────────────────────────────────


class GitRestore:
    """Save and restore llvm-project working tree."""

    def __init__(self):
        self.llvm_src = LLVM_SRC
        self.original_branch = None
        self.original_sha = None

    def save(self):
        r = run(f"cd '{self.llvm_src}' && git branch --show-current", capture_output=True, text=True)
        self.original_branch = r.stdout.strip() or ""
        r = run(f"cd '{self.llvm_src}' && git rev-parse HEAD", capture_output=True, text=True)
        self.original_sha = r.stdout.strip() or ""

    def restore(self):
        if self.original_branch:
            run(f"cd '{self.llvm_src}' && git checkout '{self.original_branch}' 2>/dev/null || git checkout '{self.original_sha}'")
        else:
            run(f"cd '{self.llvm_src}' && git checkout '{self.original_sha}'")


def fetch_pr(pr_id: str, verbose: bool) -> tuple[str, str]:
    """Fetch PR branch. Returns (local_branch, commit_sha)."""
    local_branch = f"pr-{pr_id}-local"
    check_logged(
        "fetch-remote",
        f"cd '{LLVM_SRC}' && git fetch origin pull/{pr_id}/head:{local_branch}",
        str(LOG_DIR / "fetch-remote.log"), verbose=verbose,
    )
    r = run(f"cd '{LLVM_SRC}' && git rev-parse {local_branch}", capture_output=True, text=True)
    return local_branch, r.stdout.strip()


def fetch_main(verbose: bool):
    """Fetch the true upstream main for merge-base calculation."""
    ref = baseref.base_ref(str(LLVM_SRC))
    remote = ref.split("/")[0]
    check_logged(
        "fetch-remote",
        f"cd '{LLVM_SRC}' && git fetch {remote} main",
        str(LOG_DIR / "fetch-remote.log"), verbose=verbose,
    )


def resolve_base_commit(opt_branch: str, base_ref_name: str | None) -> str:
    """Resolve the base commit via the shared baseref module."""
    sha, _ = baseref.resolve_base(str(LLVM_SRC), opt_branch, base_ref_name)
    return sha


def get_current_branch() -> str:
    """Get current branch name of the LLVM source tree."""
    r = run(f"cd '{LLVM_SRC}' && git branch --show-current", capture_output=True, text=True)
    branch = r.stdout.strip()
    if not branch:
        r = run(f"cd '{LLVM_SRC}' && git rev-parse --short HEAD", capture_output=True, text=True)
        print(f"Warning: detached HEAD, using commit {r.stdout.strip()} as branch name")
        return r.stdout.strip()
    return branch


def get_commit_info(ref: str = "HEAD") -> dict:
    """Get metadata for a commit of the LLVM source tree."""
    fmt = "%H%x1f%h%x1f%an%x1f%ad%x1f%s"
    r = run(
        f"cd '{LLVM_SRC}' && git log -1 --date=iso-strict --format={fmt} {ref}",
        capture_output=True, text=True,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    sha, short, author, date, subject = r.stdout.strip().split("\x1f")
    return {"sha": sha, "short": short, "author": author, "date": date, "subject": subject}


# ── Pipeline step implementations ──────────────────────────────────────────
# 每个步骤是一个 Step(name, fn)；fn(ctx) 返回可选备注，失败抛 StepFailure。


def _build_llvm(phase: str, verbose: bool):
    check_logged(
        f"build-llvm-{phase}",
        f"BUILD_LLVM_DIR='{BUILD_LLVM_DIR}' LLVM_SRC_DIR='{LLVM_SRC}' "
        f"sh '{ROOT}/scripts/build-llvm.sh'",
        str(LOG_DIR / f"build-llvm-{phase}.log"), verbose=verbose,
    )


def _build_ts(phase: str, flag: str, suites: str, verbose: bool):
    check_logged(
        f"build-ts-{phase}",
        f'cd "{ROOT}" && make -f scripts/Makefile '
        f'SUITES="{suites}" PHASE={phase} build copy-asm',
        str(LOG_DIR / f"build-ts-{phase}.log"), verbose=verbose,
        env=env_for_phase(phase, flag, suites),
    )


def publish_branch(
    args, state: dict, entries: list[tuple[str, str, str]], label: str, commit_sha: str
) -> str:
    """可选：把差异发布为工具仓库的一个分支（2 个 commit）。

    entries: [(带 suite 前缀的相对路径, base 绝对路径, opt 绝对路径)]。
    commit 1 = base 侧汇编（results/<path>），commit 2 = opt 侧替换。
    完成后切回原分支；results/ 工作目录随后由 create_results 重建为规范布局。
    前置条件：调用方已检查工具仓库无 *已跟踪* 改动。
    """
    branch = state["branch"]
    info = get_commit_info() or get_commit_info(commit_sha)
    short = info.get("short", commit_sha[:8])
    desc = "\n".join(
        [
            f"LLVM commit: {info.get('sha', commit_sha)}",
            f"Author: {info.get('author', 'unknown')}",
            f"Date: {info.get('date', 'unknown')}",
            f"Subject: {info.get('subject', 'unknown')}",
        ]
    )

    r = run(f"cd '{ROOT}' && git branch --show-current", capture_output=True, text=True)
    orig_branch = r.stdout.strip()

    def stage_and_commit(side: str, title_prefix: str):
        if RESULTS_DIR.exists():
            shutil.rmtree(RESULTS_DIR)
        RESULTS_DIR.mkdir(parents=True)
        for rel, base_abs, opt_abs in entries:
            dst = RESULTS_DIR / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(base_abs if side == "base" else opt_abs, dst)
        check(f"cd '{ROOT}' && git add -A results")
        subprocess.run(
            ["git", "-C", str(ROOT), "commit", "--allow-empty",
             "-m", f"{title_prefix}: {label} ({args.flag}) {short}", "-m", desc],
            check=True, stdout=subprocess.DEVNULL,
        )

    check(f"cd '{ROOT}' && git checkout -B '{branch}' main")
    try:
        stage_and_commit("base", "base")
        stage_and_commit("opt", "opt")
    finally:
        if orig_branch:
            run(f"cd '{ROOT}' && git checkout '{orig_branch}' 2>/dev/null || true")
    print(f"Published branch '{branch}' (2 commits). Push it to view the diff on GitHub.")
    return branch


def create_results(ctx: "RunContext") -> str:
    """Step 9：对比 base/opt 汇编，写出 results/ 产物。返回 "diff" 或 "no_diff"。"""
    # 重读 state：前面步骤写入的 commit_sha / merge_base 需要在这里用
    state = read_state() or {}
    args = ctx.args
    if RESULTS_DIR.exists():
        shutil.rmtree(RESULTS_DIR)
    RESULTS_DIR.mkdir(parents=True)

    suites = [s.strip() for s in args.test.split(",") if s.strip()]
    # entries 保留每侧绝对路径（拷贝用）；merged 为报告用的带 suite 前缀路径。
    entries: list[tuple[str, str, str]] = []
    merged: list[asmcompare.FileDiff] = []
    for suite in suites:
        base_suite = BUILD_DIR / "asm" / "base" / suite
        opt_suite = BUILD_DIR / "asm" / "opt" / suite
        if base_suite.is_dir() and opt_suite.is_dir():
            c = asmcompare.compare(str(base_suite), str(opt_suite))
            for fd in c:
                base_abs, opt_abs = c.paths(fd)
                entries.append((f"{suite}/{fd.path}", base_abs, opt_abs))
                merged.append(asmcompare.FileDiff(f"{suite}/{fd.path}", fd.added, fd.removed))
        else:
            print(f"[warn] skipping suite '{suite}': missing asm dirs "
                  f"({base_suite if not base_suite.is_dir() else opt_suite})")
    comparison = asmcompare.Comparison(merged)
    status = "diff" if len(comparison) else "no_diff"

    # --publish-branch（可选，先于 results/ 规范布局写入；publish 会重建 results/）
    published = None
    if args.publish_branch:
        if status == "no_diff":
            print("No differences — nothing to publish as a branch.")
        else:
            if ctx.pr_id:
                label = f"LLVM PR #{ctx.pr_id}"
            else:
                label = f"branch {ctx.local_branch}"
            published = publish_branch(
                args, state, entries, label, state.get("commit_sha", "")
            )

    # 规范布局：results/{base,opt}/<suite>/<suite 内路径>
    for rel, base_abs, opt_abs in entries:
        for src, side in ((base_abs, "base"), (opt_abs, "opt")):
            dst = RESULTS_DIR / side / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)

    commit_sha = state.get("commit_sha", "")
    opt_info = get_commit_info() or get_commit_info(commit_sha)
    merge_base = state.get("merge_base", "")
    base_source = (f"--base {args.base}" if args.base
                   else f"merge-base:{baseref.base_ref(str(LLVM_SRC))}")
    base_info = get_commit_info(merge_base) if merge_base else {}

    rd = report_mod.build_report(
        status=status,
        target={
            "kind": "pr" if ctx.pr_id else "branch",
            "pr": int(ctx.pr_id) if ctx.pr_id else None,
            "branch_name": ctx.local_branch,
        },
        base={"sha": merge_base, "source": base_source,
              "subject": base_info.get("subject", "")},
        opt={"sha": commit_sha, "short": opt_info.get("short", commit_sha[:8]),
             "author": opt_info.get("author", ""), "date": opt_info.get("date", ""),
             "subject": opt_info.get("subject", "")},
        flag=args.flag,
        suites=suites,
        started_at=state.get("started_at", ""),
        duration_seconds=sum(ctx.timings.values()),
        step_timings=dict(ctx.timings),
        comparison=comparison,
        published_branch=published,
    )
    json_path, md_path = report_mod.write(str(RESULTS_DIR), rd)

    s = rd["summary"]
    print(f"\nStatus : {status}")
    print(f"Report : {json_path}")
    print(f"         {md_path}")
    if status == "diff":
        print(f"Diff   : {s['files_changed']} files, "
              f"+{s['added']:,} / -{s['removed']:,} lines (net {s['net']:+,})")
        print("Inspect: results/base/<path> vs results/opt/<path>")
    if published:
        print(f"Branch : {published}")
    return status


# ── Run context + step registry ────────────────────────────────────────────


@dataclass
class RunContext:
    """一次 run 的共享上下文，在各步骤间传递。"""

    args: argparse.Namespace
    timings: dict[str, int] = field(default_factory=dict)
    pr_id: str | None = None
    local_branch: str = ""
    verbose: bool = False
    # 以下由步骤写入 / 从 state 恢复
    opt_branch: str | None = None
    commit_sha: str | None = None
    merge_base: str | None = None
    status: str | None = None

    def invalidate(self, step_names: list[str]):
        """作废步骤缓存标记（树位置漂移时由 checkout 步骤调用）。"""
        s = read_state() or {}
        for st in step_names:
            s.pop(st, None)
        write_state(s)


def _step_fetch(ctx: RunContext) -> str:
    fetch_main(ctx.verbose)
    if ctx.pr_id:
        ctx.opt_branch, ctx.commit_sha = fetch_pr(ctx.pr_id, ctx.verbose)
    else:
        r = run(f"cd '{LLVM_SRC}' && git rev-parse {ctx.local_branch}", capture_output=True, text=True)
        ctx.commit_sha = r.stdout.strip()
        ctx.opt_branch = ctx.local_branch
    runstate.set_meta(str(STATE_DIR), opt_branch=ctx.opt_branch, commit_sha=ctx.commit_sha)
    return ""


def _step_merge_base(ctx: RunContext) -> str:
    # Always re-resolve from the tree: a cached marker cannot know the remote moved.
    ctx.merge_base = resolve_base_commit(ctx.opt_branch, ctx.args.base)
    runstate.set_meta(str(STATE_DIR), merge_base=ctx.merge_base)
    note = " (--base)" if ctx.args.base else ""
    return f"{ctx.merge_base[:8]}{note}"


def _step_checkout_base(ctx: RunContext) -> str:
    # Always enforce the tree position: a previous run's failure restored the
    # worktree via GitRestore, so a cached "done" marker does not guarantee the
    # sources actually sit at the merge base.
    r = run(f"cd '{LLVM_SRC}' && git rev-parse HEAD", capture_output=True, text=True)
    prev_head = r.stdout.strip()
    check(f"cd '{LLVM_SRC}' && git checkout {ctx.merge_base}")
    if prev_head != ctx.merge_base and (step_done("build-llvm-base") or step_done("build-ts-base")):
        print("\n[..] tree moved since cached base build — invalidating base build cache")
        ctx.invalidate(["build-llvm-base", "build-ts-base"])
    return ""


def _step_checkout_opt(ctx: RunContext) -> str:
    # Always enforce the tree position (same reasoning as checkout-base).
    r = run(f"cd '{LLVM_SRC}' && git rev-parse HEAD", capture_output=True, text=True)
    prev_head = r.stdout.strip()
    check(f"cd '{LLVM_SRC}' && git checkout {ctx.opt_branch}")
    if prev_head != ctx.commit_sha and (step_done("build-llvm-opt") or step_done("build-ts-opt")):
        print("\n[..] tree moved since cached opt build — invalidating opt build cache")
        ctx.invalidate(["build-llvm-opt", "build-ts-opt"])
    return ""


STEPS_DEF = [
    Step("fetch-remote", _step_fetch),
    Step("find-merge-base", _step_merge_base),
    Step("checkout-base", _step_checkout_base, always=True),
    Step("build-llvm-base", lambda ctx: _build_llvm("base", ctx.verbose)),
    Step("build-ts-base", lambda ctx: _build_ts("base", ctx.args.flag, ctx.args.test, ctx.verbose)),
    Step("checkout-opt", _step_checkout_opt, always=True),
    Step("build-llvm-opt", lambda ctx: _build_llvm("opt", ctx.verbose)),
    Step("build-ts-opt", lambda ctx: _build_ts("opt", ctx.args.flag, ctx.args.test, ctx.verbose)),
    Step("create-results", lambda ctx: create_results(ctx)),
]
STEPS = names(STEPS_DEF)


# ── Subcommand: run ─────────────────────────────────────────────────────────


def parse_run_args(argv: list[str]):
    p = argparse.ArgumentParser(
        prog="opt-pr-cov run",
        description="Build base/opt LLVM, diff asm, write results/ (and report.json).",
    )
    p.add_argument("--pr", type=int, help="LLVM PR number")
    p.add_argument("--llvm-dir", type=Path, help="Path to llvm-project checkout (default: repos/llvm-project)")
    p.add_argument("--branch", help="Local branch name to compare (uses current branch if not set)")
    p.add_argument(
        "--base",
        help="Base commit/ref to compare against (default: merge-base of branch and upstream/main)",
    )
    p.add_argument("--flag", default="-mlsx -O3", help="Compiler flags (default: -mlsx -O3)")
    p.add_argument("--test", default="test-suite", help="Comma-separated test suites")
    p.add_argument("--fresh", action="store_true", help="Ignore cached steps, re-run all")
    p.add_argument("--from", dest="from_step", choices=STEPS, metavar="STEP",
                   help="Invalidate STEP and everything after it, then re-run from there")
    p.add_argument("--publish-branch", action="store_true",
                   help="Also create a result branch with 2 commits (opt-in; default is directory-only output)")
    p.add_argument("--fail-on-no-diff", action="store_true",
                   help="Exit 1 when base and opt produce identical asm")
    p.add_argument("--verbose", action="store_true",
                   help="Stream build output to stdout as well as log files")
    args = p.parse_args(argv)
    if not args.pr and not args.branch:
        p.error("either --pr or --branch (or both) is required")
    return args


def _porcelain(path: Path, ignore_untracked: bool = False) -> str:
    cmd = f"cd '{path}' && git status --porcelain"
    if ignore_untracked:
        cmd += " --untracked-files=no"
    r = run(cmd, capture_output=True, text=True)
    return r.stdout.strip()


def cmd_run(argv: list[str]) -> int:
    args = parse_run_args(argv)
    global LLVM_SRC
    LLVM_SRC = (args.llvm_dir or LLVM_SRC).resolve()

    if not LLVM_SRC.is_dir():
        print(f"Error: LLVM source directory not found: {LLVM_SRC}", file=sys.stderr)
        return 1

    use_pr = args.pr is not None
    use_local = args.branch is not None or not use_pr
    pr_id = str(args.pr) if use_pr else None

    # llvm-project 必须干净（步骤要 checkout）；工具仓库只在发布分支时要求
    # 无 *已跟踪* 改动（results/ 未跟踪是常态，不算脏）。
    if _porcelain(LLVM_SRC):
        print(f"Error: {LLVM_SRC} has uncommitted changes. Commit or stash first.", file=sys.stderr)
        return 1
    if args.publish_branch and _porcelain(ROOT, ignore_untracked=True):
        print(f"Error: {ROOT} has uncommitted tracked changes. Commit or stash first.", file=sys.stderr)
        return 1

    local_branch = args.branch or get_current_branch()

    state, branch = runstate.init_state(
        str(STATE_DIR), pr_id, local_branch if use_local else None,
        args.flag, args.test, args.base or "", STEPS,
    )
    state.setdefault("started_at", datetime.now(timezone.utc).isoformat(timespec="seconds"))
    write_state(state)

    if args.fresh:
        if use_pr:
            print(f"Fresh run on branch '{branch}' (PR #{pr_id})")
        else:
            print(f"Fresh run on branch '{branch}' (branch: {local_branch})")
        clear_steps()

    if args.from_step:
        todo = names_from(STEPS_DEF, args.from_step)
        s = read_state() or {}
        for st in todo:
            s.pop(st, None)
        write_state(s)
        print(f"[--from {args.from_step}] invalidating: {', '.join(todo)}")

    LOG_DIR.mkdir(parents=True, exist_ok=True)

    git = GitRestore()
    git.save()

    ctx = RunContext(
        args=args,
        verbose=args.verbose,
        pr_id=pr_id,
        local_branch=local_branch,
    )

    # Restore context persisted by earlier runs (needed when steps are skipped).
    state = read_state() or {}
    ctx.opt_branch = state.get("opt_branch")
    ctx.commit_sha = state.get("commit_sha")
    ctx.merge_base = state.get("merge_base")
    if state.get("fetch-remote") == "done" and not ctx.opt_branch:
        ctx.opt_branch = f"pr-{pr_id}-local" if use_pr else local_branch
    if ctx.opt_branch and (not ctx.commit_sha or not ctx.merge_base):
        if not ctx.commit_sha:
            r = run(f"cd '{LLVM_SRC}' && git rev-parse {ctx.opt_branch}", capture_output=True, text=True)
            ctx.commit_sha = r.stdout.strip() if r.returncode == 0 else None
        if not ctx.merge_base:
            try:
                ctx.merge_base = resolve_base_commit(ctx.opt_branch, args.base)
            except ValueError as e:
                print(f"Error: {e}", file=sys.stderr)
                return 1
        if not ctx.commit_sha or not ctx.merge_base:
            print("Error: cannot recover run context from state; use --fresh to re-run.", file=sys.stderr)
            return 1

    exit_code = 0
    try:
        Runner(
            STEPS_DEF,
            is_done=step_done,
            mark_done=lambda name: mark_step_done(name, ctx.timings),
            progress=Progress(STEPS),
        ).run(ctx)

        if ctx.status == "no_diff" and args.fail_on_no_diff:
            print("\n--fail-on-no-diff: no differences found, exiting 1", file=sys.stderr)
            exit_code = 1

        print(f"\nAll steps complete.{' Results: ' + str(RESULTS_DIR) if ctx.status != 'no_diff' else ' (no differences)'}")

    except StepFailure as e:
        exit_code = 1
        print(f"\nFAILED step '{e.step}' (exit {e.returncode}): {e.cmd}", file=sys.stderr)
        print(f"Log: {e.log_path}", file=sys.stderr)
        if e.tail:
            print("--- last lines ---", file=sys.stderr)
            for line in e.tail:
                print(line, file=sys.stderr)
    except subprocess.CalledProcessError as e:
        exit_code = 1
        print(f"\nBuild failed at step '{e.cmd}' (exit {e.returncode})", file=sys.stderr)
    except (ValueError, RuntimeError) as e:
        exit_code = 1
        print(f"\nError: {e}", file=sys.stderr)
    finally:
        git.restore()

    return exit_code


# ── Subcommand: status ──────────────────────────────────────────────────────


def cmd_status() -> int:
    state = read_state()
    if not state:
        print("No run state found. Start one with:")
        print("  ./opt-pr-cov run --pr <N>     (or --branch <name>)")
        return 0

    done = [s for s in STEPS if state.get(s) == "done"]
    pending = [s for s in STEPS if s not in done]
    identity = state.get("identity", "?")

    print(f"Run        : {identity}")
    if state.get("pr"):
        print(f"  LLVM PR  : #{state['pr']}")
    if state.get("branch_name"):
        print(f"  Branch   : {state['branch_name']}")
    print(f"Flag/Test  : {state.get('flag', '?')} | {state.get('test', '?')}")
    if state.get("base"):
        print(f"Base ref   : {state['base']} (--base)")
    if state.get("commit_sha"):
        print(f"Opt SHA    : {state['commit_sha'][:12]}")
    if state.get("merge_base"):
        print(f"Base SHA   : {state['merge_base'][:12]}")
    print(f"Steps      : {len(done)}/{len(STEPS)} done")
    for s in STEPS:
        mark = "x" if state.get(s) == "done" else " "
        d = state.get(f"dur_{s}")
        extra = f" ({fmt_seconds(int(d))})" if d else ""
        print(f"  [{mark}] {s}{extra}")
    if pending:
        print(f"Next       : {pending[0]}")
        print("Resume     : ./opt-pr-cov run  (re-run the same command; cached steps are skipped)")
        print(f"Jump       : ./opt-pr-cov run --from {pending[0]}  (redo this step and everything after)")

    rp = RESULTS_DIR / "report.json"
    if rp.exists():
        try:
            rd = json.loads(rp.read_text())
            s = rd.get("summary", {})
            print(f"Results    : {rp}")
            print(f"  status={rd.get('status')} files={s.get('files_changed')} "
                  f"+{s.get('added', 0):,} / -{s.get('removed', 0):,} "
                  f"({rd.get('started_at') or '?'})")
            if rd.get("published_branch"):
                print(f"  branch={rd['published_branch']}")
        except (json.JSONDecodeError, OSError) as e:
            print(f"Results    : {rp} (unreadable: {e})")
    else:
        print("Results    : none yet (results/report.json appears after the final step)")
    print(f"Logs       : {LOG_DIR}")
    return 0


# ── Subcommand: report ──────────────────────────────────────────────────────


def cmd_report() -> int:
    rp = RESULTS_DIR / "report.json"
    if not rp.exists():
        print(f"Error: {rp} not found. Run a comparison first:", file=sys.stderr)
        print("  ./opt-pr-cov run --pr <N>", file=sys.stderr)
        return 1
    try:
        rd = json.loads(rp.read_text())
    except json.JSONDecodeError as e:
        print(f"Error: {rp} is not valid JSON: {e}", file=sys.stderr)
        return 1
    md_path = RESULTS_DIR / "report.md"
    md_path.write_text(report_mod.render_markdown(rd))
    print(f"Rendered {md_path} (status={rd.get('status')}, "
          f"{rd.get('summary', {}).get('files_changed', 0)} files)")
    return 0


# ── Main ────────────────────────────────────────────────────────────────────


def main() -> None:
    argv = sys.argv[1:]
    if argv and argv[0] in SUBCOMMANDS:
        cmd, rest = argv[0], argv[1:]
    else:
        # Backward compat: bare flags imply `run` (e.g. ./opt-pr-cov --pr 12345)
        cmd, rest = "run", argv

    if cmd == "status":
        sys.exit(cmd_status())
    if cmd == "report":
        sys.exit(cmd_report())
    sys.exit(cmd_run(rest))


if __name__ == "__main__":
    main()
