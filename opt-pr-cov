#!/usr/bin/env python3
"""Local LLVM optimization comparison — build base/opt, diff asm, create commits.

Usage:
    ./opt-pr-cov --pr 12345
    ./opt-pr-cov --branch my-feature
    ./opt-pr-cov --branch my-feature --llvm-dir /path/to/llvm --flag "-O2" --test "test-suite,polybench"
    ./opt-pr-cov --pr 12345 --fresh          # re-run from scratch
"""

import argparse
import os
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

# ── Paths (match workflow env layout) ───────────────────────────────────────

ROOT = Path(__file__).resolve().parent
LLVM_SRC = ROOT / "repos" / "llvm-project"
TS_SRC = ROOT / "repos" / "llvm-test-suite"
BUILD_LLVM_DIR = ROOT / "build" / "build-llvm"
BUILD_DIR = ROOT / "build"
RESULTS_DIR = ROOT / "results"
STATE_DIR = BUILD_DIR / ".state"

# ── Steps ──────────────────────────────────────────────────────────────────

STEPS = [
    "fetch-remote",
    "find-merge-base",
    "checkout-base",
    "build-llvm-base",
    "build-ts-base",
    "checkout-opt",
    "build-llvm-opt",
    "build-ts-opt",
    "create-commits",
]

# ── Helpers ─────────────────────────────────────────────────────────────────


def run(cmd: str, **kwargs):
    """Run a shell command, return CompletedProcess."""
    return subprocess.run(cmd, shell=True, **kwargs)


def check(cmd: str, **kwargs):
    """Run a shell command, raise on failure."""
    subprocess.run(cmd, shell=True, check=True, **kwargs)


def fmt_seconds(seconds: int) -> str:
    m, s = divmod(seconds, 60)
    return f"{m}m {s}s" if m else f"{s}s"


def env_for_phase(phase: str, flag: str, suites: str) -> dict:
    """Build env dict for Makefile-based test-suite build."""
    e = os.environ.copy()
    e.update(
        BUILD_DIR=str(BUILD_DIR / phase),
        ASM_DIR=str(BUILD_DIR),
        BUILD_LLVM_DIR=str(BUILD_LLVM_DIR),
        TS_SRC_DIR=str(TS_SRC),
        LLVM_SRC_DIR=str(LLVM_SRC),
        FLAG=flag,
    )
    return e


# ── State management ───────────────────────────────────────────────────────


def _state_path() -> Path:
    return STATE_DIR / "current"


def read_state() -> dict | None:
    p = _state_path()
    if not p.exists():
        return None
    d = {}
    for line in p.read_text().splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            d[k] = v
    return d


def write_state(d: dict):
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    _state_path().write_text("\n".join(f"{k}={v}" for k, v in d.items()) + "\n")


def mark_step(step: str):
    s = read_state() or {}
    s[step] = "done"
    write_state(s)


def step_done(step: str) -> bool:
    s = read_state() or {}
    return s.get(step) == "done"


def init_state(pr_id: str | None, branch_name: str | None, flag: str, tests: str) -> str:
    """Create or reuse state. Returns result branch name."""
    existing = read_state()

    # Determine identity key for state lookup
    if pr_id:
        identity = f"pr-{pr_id}"
    else:
        identity = f"branch-{branch_name}"

    # Backward compat: old state files used "pr" key instead of "identity"
    if existing and "identity" not in existing and existing.get("pr"):
        existing["identity"] = f"pr-{existing['pr']}"

    if existing and existing.get("identity") == identity:
        # Same target — reuse timestamp
        result_branch = existing["branch"]
        # Check parameters — auto-clear if changed
        if existing.get("flag") != flag or existing.get("test") != tests:
            for s in STEPS:
                existing.pop(s, None)
            existing["flag"] = flag
            existing["test"] = tests
            write_state(existing)
    else:
        # New or different target — fresh timestamp
        ts = datetime.now().strftime("%Y%m%d_%H%M%S")
        if pr_id:
            result_branch = f"opt-pr-{pr_id}-{ts}"
        else:
            result_branch = f"opt-{branch_name}-{ts}"
        existing = {
            "identity": identity,
            "branch": result_branch,
            "flag": flag,
            "test": tests,
        }
        if pr_id:
            existing["pr"] = pr_id
        if branch_name:
            existing["branch_name"] = branch_name

    write_state(existing)
    return existing["branch"]


def clear_steps():
    """Remove all step markers, keep metadata."""
    s = read_state() or {}
    for step in STEPS:
        s.pop(step, None)
    write_state(s)


# ── Progress display ────────────────────────────────────────────────────────


class Progress:
    def __init__(self, steps: list[str], done: set[str]):
        self.steps = steps
        self.done = done
        self.max_len = max(len(s) for s in steps)

    def draw(self, current: str | None = None):
        lines = []
        for i, step in enumerate(self.steps, 1):
            if step in self.done:
                marker = "[OK]"
            elif step == current:
                marker = "[-->]"
            else:
                marker = "[  ]"
            lines.append(f"{marker} Step {i}/{len(self.steps)}: {step}")
        print("\r" + "\n".join(lines))


# ── Git helpers ─────────────────────────────────────────────────────────────


class GitRestore:
    """Save and restore llvm-project working tree."""

    def __init__(self):
        self.llvm_src = LLVM_SRC
        self.original_branch = None
        self.original_sha = None

    def save(self):
        r = run(f"cd '{self.llvm_src}' && git branch --show-current", capture_output=True, text=True)
        self.original_branch = r.stdout.strip() or ""
        r = run(f"cd '{self.llvm_src}' && git rev-parse HEAD", capture_output=True, text=True)
        self.original_sha = r.stdout.strip() or ""

    def restore(self):
        if self.original_branch:
            run(f"cd '{self.llvm_src}' && git checkout '{self.original_branch}' 2>/dev/null || git checkout '{self.original_sha}'")
        else:
            run(f"cd '{self.llvm_src}' && git checkout '{self.original_sha}'")


def fetch_pr(pr_id: str) -> tuple[str, str]:
    """Fetch PR branch. Returns (local_branch, commit_sha)."""
    local_branch = f"pr-{pr_id}-local"
    check(f"cd '{LLVM_SRC}' && git fetch origin pull/{pr_id}/head:{local_branch}")
    r = run(f"cd '{LLVM_SRC}' && git rev-parse {local_branch}", capture_output=True, text=True)
    return local_branch, r.stdout.strip()


def fetch_main():
    """Fetch origin/main for merge-base calculation."""
    check(f"cd '{LLVM_SRC}' && git fetch origin main")


def find_merge_base(opt_branch: str) -> str:
    """Find merge-base between main and opt_branch. Returns commit SHA."""
    r = run(f"cd '{LLVM_SRC}' && git merge-base main {opt_branch}", capture_output=True, text=True)
    if r.returncode != 0:
        print(f"Error: cannot find merge-base between main and {opt_branch}", file=sys.stderr)
        print(f"  {r.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return r.stdout.strip()


def get_current_branch() -> str:
    """Get current branch name."""
    r = run(f"cd '{LLVM_SRC}' && git branch --show-current", capture_output=True, text=True)
    branch = r.stdout.strip()
    if not branch:
        r = run(f"cd '{LLVM_SRC}' && git rev-parse --short HEAD", capture_output=True, text=True)
        print(f"Warning: detached HEAD, using commit {r.stdout.strip()} as branch name")
        return r.stdout.strip()
    return branch


# ── Step implementations ───────────────────────────────────────────────────


def step_build_llvm():
    check(
        f"BUILD_LLVM_DIR='{BUILD_LLVM_DIR}' LLVM_SRC_DIR='{LLVM_SRC}' "
        f"sh '{ROOT}/scripts/build-llvm.sh'"
    )


def step_build_ts(phase: str, flag: str, suites: str):
    check(
        f'cd "{ROOT}" && make -f scripts/Makefile '
        f'SUITES="{suites}" PHASE={phase} build copy-asm',
        env=env_for_phase(phase, flag, suites),
    )


def diff_files(base_dir: str, opt_dir: str) -> list[tuple[str, str, str]]:
    """Find differing files. Returns [(rel, base_file, opt_file)]."""
    diffs = []
    proc = os.popen(f"diff -rq '{base_dir}' '{opt_dir}' 2>/dev/null | grep -i differ || true")
    for line in proc:
        line = line.strip()
        if not line:
            continue
        try:
            parts = line.split()
            f1, f2 = parts[1], parts[3]
            rel = f1.removeprefix(base_dir + "/")
            diffs.append((rel, f1, f2))
        except (IndexError, AttributeError):
            continue
    proc.close()
    return diffs


def create_commits(branch: str, label: str, flag: str, tests: str, commit_sha: str):
    """Create branch with two commits: base files, then opt files."""
    # Only copy differing files
    all_diffs: list[tuple[str, str, str]] = []
    for suite in tests.split(","):
        suite = suite.strip()
        base_suite = BUILD_DIR / "asm" / "base" / suite
        opt_suite = BUILD_DIR / "asm" / "opt" / suite
        if base_suite.is_dir() and opt_suite.is_dir():
            all_diffs.extend(diff_files(str(base_suite), str(opt_suite)))

    if not all_diffs:
        print("\nNo differences found between base and opt.")
        return

    # Clean and create branch from main
    check(f"cd '{ROOT}' && git checkout -B '{branch}' main")
    check(f"cd '{ROOT}' && git clean -ffd")
    check(f"cd '{ROOT}' && git rm -rf . 2>/dev/null || true")

    # Copy differing files from base
    for rel, f1, f2 in all_diffs:
        dst = RESULTS_DIR / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(f1, dst)

    # Commit 1: base
    check(f"cd '{ROOT}' && git add -A")
    msg = f"base: {label} ({flag}) {commit_sha}"
    check(f"cd '{ROOT}' && git commit -m '{msg}' --allow-empty")

    # Copy differing files from opt
    for rel, f1, f2 in all_diffs:
        dst = RESULTS_DIR / rel
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(f2, dst)

    # Commit 2: opt
    check(f"cd '{ROOT}' && git add -A")
    msg = f"opt: {label} ({flag}) {commit_sha}"
    check(f"cd '{ROOT}' && git commit -m '{msg}' --allow-empty")

    print(f"\nBranch '{branch}' created with 2 commits.")
    print(f"  Run: git diff HEAD~1  (view changes)")


# ── Main ────────────────────────────────────────────────────────────────────


def parse_args():
    p = argparse.ArgumentParser(description="Local LLVM opt comparison")
    p.add_argument("--pr", type=int, help="LLVM PR number")
    p.add_argument("--llvm-dir", type=Path, help="Path to llvm-project checkout (default: repos/llvm-project)")
    p.add_argument("--branch", help="Local branch name to compare (uses current branch if not set)")
    p.add_argument("--flag", default="-mlsx -O3", help="Compiler flags (default: -mlsx -O3)")
    p.add_argument("--test", default="test-suite", help="Comma-separated test suites")
    p.add_argument("--fresh", action="store_true", help="Ignore cache, re-run all steps")
    args = p.parse_args()
    if not args.pr and not args.branch:
        p.error("either --pr or --branch (or both) is required")
    return args


def main():
    args = parse_args()
    global LLVM_SRC
    LLVM_SRC = (args.llvm_dir or LLVM_SRC).resolve()

    if not LLVM_SRC.is_dir():
        print(f"Error: LLVM source directory not found: {LLVM_SRC}", file=sys.stderr)
        sys.exit(1)

    # Determine mode
    use_pr = args.pr is not None
    use_local = args.branch is not None or not use_pr

    if use_pr:
        pr_id = str(args.pr)
    else:
        pr_id = None

    # Check for uncommitted changes in llvm-project
    r = run(f"cd '{LLVM_SRC}' && git status --porcelain", capture_output=True, text=True)
    if r.stdout.strip():
        print(f"Error: {LLVM_SRC} has uncommitted changes. Commit or stash first.", file=sys.stderr)
        sys.exit(1)

    # Check for uncommitted changes in this repo (results/ might be in a branch)
    r = run(f"cd '{ROOT}' && git status --porcelain", capture_output=True, text=True)
    if r.stdout.strip():
        print(f"Error: {ROOT} has uncommitted changes. Commit or stash first.", file=sys.stderr)
        sys.exit(1)

    # Resolve local branch name if not specified
    local_branch = args.branch or get_current_branch()

    # Init state / branch name
    branch = init_state(pr_id, local_branch if use_local else None, args.flag, args.test)

    if args.fresh:
        if use_pr:
            print(f"Fresh run on branch '{branch}' (PR #{pr_id})")
        else:
            print(f"Fresh run on branch '{branch}' (branch: {local_branch})")
        clear_steps()

    git = GitRestore()
    git.save()

    # Determine which steps to run
    done = {s for s in STEPS if step_done(s)}
    prog = Progress(STEPS, done)
    prog.draw()

    opt_branch = None
    commit_sha = None
    merge_base = None

    try:
        step_num = 0

        # ── Step 1: Fetch remote ──
        if not step_done("fetch-remote"):
            prog.draw("fetch-remote")
            t0 = time.time()
            step_num = 1
            if use_pr:
                check(f"cd '{LLVM_SRC}' && git fetch origin main")
                opt_branch, commit_sha = fetch_pr(pr_id)
            else:
                check(f"cd '{LLVM_SRC}' && git fetch origin main")
                r = run(f"cd '{LLVM_SRC}' && git rev-parse {local_branch}", capture_output=True, text=True)
                commit_sha = r.stdout.strip()
                opt_branch = local_branch
            print(f"\n[OK] Step {step_num}/9: fetch-remote   ({fmt_seconds(int(time.time()-t0))})")
            mark_step("fetch-remote")

        # ── Step 2: Find merge-base ──
        if not step_done("find-merge-base"):
            prog.draw("find-merge-base")
            t0 = time.time()
            step_num = 2
            merge_base = find_merge_base(opt_branch)
            print(f"\n[OK] Step {step_num}/9: find-merge-base ({fmt_seconds(int(time.time()-t0))}) — {merge_base[:8]}")
            mark_step("find-merge-base")

        # ── Step 3: Checkout base ──
        if not step_done("checkout-base"):
            prog.draw("checkout-base")
            t0 = time.time()
            step_num = 3
            check(f"cd '{LLVM_SRC}' && git checkout {merge_base}")
            mark_step("checkout-base")

        # ── Step 4: Build LLVM (base) ──
        if not step_done("build-llvm-base"):
            prog.draw("build-llvm-base")
            t0 = time.time()
            step_num = 4
            step_build_llvm()
            print(f"\n[OK] Step {step_num}/9: build-llvm-base ({fmt_seconds(int(time.time()-t0))})")
            mark_step("build-llvm-base")

        # ── Step 5: Build test suites (base) ──
        if not step_done("build-ts-base"):
            prog.draw("build-ts-base")
            t0 = time.time()
            step_num = 5
            step_build_ts("base", args.flag, args.test)
            print(f"\n[OK] Step {step_num}/9: build-ts-base   ({fmt_seconds(int(time.time()-t0))})")
            mark_step("build-ts-base")

        # ── Step 6: Checkout opt ──
        if not step_done("checkout-opt"):
            prog.draw("checkout-opt")
            t0 = time.time()
            step_num = 6
            check(f"cd '{LLVM_SRC}' && git checkout {opt_branch}")
            mark_step("checkout-opt")

        # ── Step 7: Build LLVM (opt) ──
        if not step_done("build-llvm-opt"):
            prog.draw("build-llvm-opt")
            t0 = time.time()
            step_num = 7
            step_build_llvm()
            print(f"\n[OK] Step {step_num}/9: build-llvm-opt  ({fmt_seconds(int(time.time()-t0))})")
            mark_step("build-llvm-opt")

        # ── Step 8: Build test suites (opt) ──
        if not step_done("build-ts-opt"):
            prog.draw("build-ts-opt")
            t0 = time.time()
            step_num = 8
            step_build_ts("opt", args.flag, args.test)
            print(f"\n[OK] Step {step_num}/9: build-ts-opt    ({fmt_seconds(int(time.time()-t0))})")
            mark_step("build-ts-opt")

        # ── Step 9: Create commits ──
        if not step_done("create-commits"):
            prog.draw("create-commits")
            t0 = time.time()
            step_num = 9
            if use_pr:
                label = f"LLVM PR #{pr_id}"
            else:
                label = f"branch {local_branch}"
            create_commits(branch, label, args.flag, args.test, commit_sha)
            mark_step("create-commits")

        print("\nAll steps complete. Branch:", branch)

    except subprocess.CalledProcessError as e:
        print(f"\nBuild failed at step '{e.cmd}' (exit {e.returncode})", file=sys.stderr)
        sys.exit(1)
    finally:
        git.restore()


if __name__ == "__main__":
    main()