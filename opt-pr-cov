# ── Helpers ─────────────────────────────────────────────────────────────────


def env_for_phase(phase: str, flag: str, suites: str) -> dict:
    """Build env dict for Makefile-based test-suite build."""
    e = os.environ.copy()
    e.update(
        BUILD_DIR=str(BUILD_DIR / phase),
        ASM_DIR=str(BUILD_DIR),
        BUILD_LLVM_DIR=str(BUILD_LLVM_DIR),
        TS_SRC_DIR=str(TS_SRC),
        LLVM_SRC_DIR=str(LLVM_SRC),
        FLAG=flag,
    )
    return e


def run(cmd: str, **kwargs):
    """Run a shell command, return CompletedProcess."""
    return subprocess.run(cmd, shell=True, **kwargs)


def check(cmd: str, **kwargs):
    """Run a shell command, raise on failure."""
    subprocess.run(cmd, shell=True, check=True, **kwargs)


