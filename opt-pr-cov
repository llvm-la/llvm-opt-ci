# ── Helpers ─────────────────────────────────────────────────────────────────


def fmt_seconds(seconds: int) -> str:
    m, s = divmod(seconds, 60)
    return f"{m}m {s}s" if m else f"{s}s"


def env_for_phase(phase: str, flag: str, suites: str) -> dict:
    """Build env dict for Makefile-based test-suite build."""
    e = os.environ.copy()
    e.update(
        BUILD_DIR=str(BUILD_DIR / phase),
        ASM_DIR=str(BUILD_DIR),
        BUILD_LLVM_DIR=str(BUILD_LLVM_DIR),
        TS_SRC_DIR=str(TS_SRC),
        LLVM_SRC_DIR=str(LLVM_SRC),
        FLAG=flag,
    )
    return e


# ── Process helpers ────────────────────────────────────────────────────────
# run/check 用于快速的 git 查询（输出本来就短，直接进 stdout）。
# run_logged/check_logged 用于高噪声步骤（fetch/build）：输出全部 tee 进
# 日志文件，stdout 保持安静；失败时由 StepFailure 携带最后 30 行 + 日志路径。


def run(cmd: str, **kwargs):
    """Run a shell command, return CompletedProcess."""
    return subprocess.run(cmd, shell=True, **kwargs)


def check(cmd: str, **kwargs):
    """Run a shell command, raise on failure."""
    subprocess.run(cmd, shell=True, check=True, **kwargs)


class StepFailure(Exception):
    """高噪声步骤失败：附日志路径与错误尾部。"""

    def __init__(self, cmd: str, returncode: int, log_path: str, tail: list[str]):
        self.cmd = cmd
        self.returncode = returncode
        self.log_path = log_path
        self.tail = tail
        super().__init__(f"exit {returncode}: {cmd}")


def run_logged(cmd: str, log_path: str, verbose: bool = False, **kwargs):
    """执行命令，stdout/stderr 全量写入 log_path。返回 (returncode, 最后30行)。"""
    os.makedirs(os.path.dirname(log_path), exist_ok=True)
    tail: deque[bytes] = deque(maxlen=30)
    with open(log_path, "w") as log:
        proc = subprocess.Popen(
            cmd, shell=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, **kwargs
        )
        assert proc.stdout is not None
        for raw in iter(proc.stdout.readline, b""):
            log.write(raw)
            log.flush()
            tail.append(raw)
            if verbose:
                sys.stdout.buffer.write(raw)
                sys.stdout.flush()
        rc = proc.wait()
    decoded = [line.decode(errors="replace").rstrip() for line in tail]
    return rc, decoded


def check_logged(cmd: str, log_path: str, verbose: bool = False, **kwargs):
    rc, tail = run_logged(cmd, log_path, verbose=verbose, **kwargs)
    if rc != 0:
        raise StepFailure(cmd, rc, log_path, tail)


# ── State (thin wrappers over runstate) ────────────────────────────────────


def read_state() -> dict | None:
    return runstate.read(str(STATE_DIR))


def write_state(d: dict):
    runstate.write(str(STATE_DIR), d)


def mark_step(step: str, **meta):
    runstate.mark_step(str(STATE_DIR), step, **meta)


def mark_step_done(step: str, timings: dict[str, int]):
    """标记步骤完成并记录耗时（dur_<step>，供 status 展示）。"""
    runstate.mark_step(str(STATE_DIR), step, **{f"dur_{step}": timings[step]})


def step_done(step: str) -> bool:
    return runstate.step_done(str(STATE_DIR), step)


def clear_steps():
    runstate.clear_steps(str(STATE_DIR), STEPS)


# ── Progress display ────────────────────────────────────────────────────────


class Progress:
    def __init__(self, steps: list[str], done: set[str]):
        self.steps = steps
        self.done = done
        self.max_len = max(len(s) for s in steps)

    def draw(self, current: str | None = None):
        lines = []
        for i, step in enumerate(self.steps, 1):
            if step in self.done:
                marker = "[OK]"
            elif step == current:
                marker = "[-->]"
            else:
                marker = "[  ]"
            lines.append(f"{marker} Step {i}/{len(self.steps)}: {step}")
        print("\r" + "\n".join(lines))


# ── Git helpers ─────────────────────────────────────────────────────────────


class GitRestore:
    """Save and restore llvm-project working tree."""

    def __init__(self):
        self.llvm_src = LLVM_SRC
        self.original_branch = None
        self.original_sha = None

    def save(self):
        r = run(f"cd '{self.llvm_src}' && git branch --show-current", capture_output=True, text=True)
        self.original_branch = r.stdout.strip() or ""
        r = run(f"cd '{self.llvm_src}' && git rev-parse HEAD", capture_output=True, text=True)
        self.original_sha = r.stdout.strip() or ""

    def restore(self):
        if self.original_branch:
            run(f"cd '{self.llvm_src}' && git checkout '{self.original_branch}' 2>/dev/null || git checkout '{self.original_sha}'")
        else:
            run(f"cd '{self.llvm_src}' && git checkout '{self.original_sha}'")


def fetch_pr(pr_id: str, verbose: bool) -> tuple[str, str]:
    """Fetch PR branch. Returns (local_branch, commit_sha)."""
    local_branch = f"pr-{pr_id}-local"
    check_logged(
        f"cd '{LLVM_SRC}' && git fetch origin pull/{pr_id}/head:{local_branch}",
        str(LOG_DIR / "fetch-remote.log"), verbose=verbose,
    )
    r = run(f"cd '{LLVM_SRC}' && git rev-parse {local_branch}", capture_output=True, text=True)
    return local_branch, r.stdout.strip()


MAIN_REF: str | None = None


def main_ref() -> str:
    """Ref used as the true base: upstream/main when an 'upstream' remote exists.

    The fork's origin/main can lag far behind the real llvm-project, which
    would drag the merge-base (and thus the base build) hundreds of commits
    below where the branch was actually created.
    """
    global MAIN_REF
    if MAIN_REF is None:
        r = run(f"cd '{LLVM_SRC}' && git remote get-url upstream", capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            MAIN_REF = "upstream/main"
        else:
            print(
                "Warning: no 'upstream' remote in llvm-project; "
                "merge-base falls back to local main (stale if origin is a fork).",
                file=sys.stderr,
            )
            MAIN_REF = "main"
    return MAIN_REF


def fetch_main(verbose: bool):
    """Fetch the true upstream main for merge-base calculation."""
    ref = main_ref()
    remote = ref.split("/")[0]
    check_logged(
        f"cd '{LLVM_SRC}' && git fetch {remote} main",
        str(LOG_DIR / "fetch-remote.log"), verbose=verbose,
    )


def find_merge_base(opt_branch: str) -> str:
    """Find merge-base between the true main and opt_branch. Returns commit SHA."""
    ref = main_ref()
    r = run(f"cd '{LLVM_SRC}' && git merge-base {ref} {opt_branch}", capture_output=True, text=True)
    if r.returncode != 0:
        print(f"Error: cannot find merge-base between {ref} and {opt_branch}", file=sys.stderr)
        print(f"  {r.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return r.stdout.strip()


def resolve_base_commit(opt_branch: str, base_ref: str | None) -> str:
    """Resolve the base commit: explicit --base ref, else merge-base with main."""
    if not base_ref:
        return find_merge_base(opt_branch)
    r = run(f"cd '{LLVM_SRC}' && git rev-parse {base_ref}", capture_output=True, text=True)
    if r.returncode != 0:
        print(f"Error: invalid --base ref: {base_ref}", file=sys.stderr)
        print(f"  {r.stderr.strip()}", file=sys.stderr)
        sys.exit(1)
    return r.stdout.strip()


def get_current_branch() -> str:
    """Get current branch name of the LLVM source tree."""
    r = run(f"cd '{LLVM_SRC}' && git branch --show-current", capture_output=True, text=True)
    branch = r.stdout.strip()
    if not branch:
        r = run(f"cd '{LLVM_SRC}' && git rev-parse --short HEAD", capture_output=True, text=True)
        print(f"Warning: detached HEAD, using commit {r.stdout.strip()} as branch name")
        return r.stdout.strip()
    return branch


def get_commit_info(ref: str = "HEAD") -> dict:
    """Get metadata for a commit of the LLVM source tree."""
    fmt = "%H%x1f%h%x1f%an%x1f%ad%x1f%s"
    r = run(
        f"cd '{LLVM_SRC}' && git log -1 --date=iso-strict --format={fmt} {ref}",
        capture_output=True, text=True,
    )
    if r.returncode != 0 or not r.stdout.strip():
        return {}
    sha, short, author, date, subject = r.stdout.strip().split("\x1f")
    return {"sha": sha, "short": short, "author": author, "date": date, "subject": subject}


# ── Step implementations ───────────────────────────────────────────────────


def step_build_llvm(phase: str, verbose: bool):
    check_logged(
        f"BUILD_LLVM_DIR='{BUILD_LLVM_DIR}' LLVM_SRC_DIR='{LLVM_SRC}' "
        f"sh '{ROOT}/scripts/build-llvm.sh'",
        str(LOG_DIR / f"build-llvm-{phase}.log"), verbose=verbose,
    )


def step_build_ts(phase: str, flag: str, suites: str, verbose: bool):
    check_logged(
        f'cd "{ROOT}" && make -f scripts/Makefile '
        f'SUITES="{suites}" PHASE={phase} build copy-asm',
        str(LOG_DIR / f"build-ts-{phase}.log"), verbose=verbose,
        env=env_for_phase(phase, flag, suites),
    )


def publish_branch(
    args, state: dict, entries: list[tuple[str, str, str]], label: str, commit_sha: str
) -> str:
    """可选：把差异发布为工具仓库的一个分支（2 个 commit）。

    entries: [(带 suite 前缀的相对路径, base 绝对路径, opt 绝对路径)]。
    commit 1 = base 侧汇编（results/<path>），commit 2 = opt 侧替换。
    完成后切回原分支；results/ 工作目录随后由 create_results 重建为规范布局。
    前置条件：调用方已检查工具仓库无 *已跟踪* 改动。
    """
    branch = state["branch"]
    info = get_commit_info() or get_commit_info(commit_sha)
    short = info.get("short", commit_sha[:8])
    desc = "\n".join(
        [
            f"LLVM commit: {info.get('sha', commit_sha)}",
            f"Author: {info.get('author', 'unknown')}",
            f"Date: {info.get('date', 'unknown')}",
            f"Subject: {info.get('subject', 'unknown')}",
        ]
    )

    r = run(f"cd '{ROOT}' && git branch --show-current", capture_output=True, text=True)
    orig_branch = r.stdout.strip()

    def stage_and_commit(side: str, title_prefix: str):
        if RESULTS_DIR.exists():
            shutil.rmtree(RESULTS_DIR)
        RESULTS_DIR.mkdir(parents=True)
        for rel, base_abs, opt_abs in entries:
            dst = RESULTS_DIR / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(base_abs if side == "base" else opt_abs, dst)
        check(f"cd '{ROOT}' && git add -A results")
        subprocess.run(
            ["git", "-C", str(ROOT), "commit", "--allow-empty",
             "-m", f"{title_prefix}: {label} ({args.flag}) {short}", "-m", desc],
            check=True, stdout=subprocess.DEVNULL,
        )

    check(f"cd '{ROOT}' && git checkout -B '{branch}' main")
    try:
        stage_and_commit("base", "base")
        stage_and_commit("opt", "opt")
    finally:
        if orig_branch:
            run(f"cd '{ROOT}' && git checkout '{orig_branch}' 2>/dev/null || true")
    print(f"Published branch '{branch}' (2 commits). Push it to view the diff on GitHub.")
    return branch


def create_results(
    args, timings: dict[str, int], pr_id: str | None, local_branch: str
) -> str:
    """Step 9：对比 base/opt 汇编，写出 results/ 产物。返回 "diff" 或 "no_diff"。"""
    # 重读 state：前面步骤 mark_step 写入的 commit_sha / merge_base 需要在这里用
    state = read_state() or {}
    if RESULTS_DIR.exists():
        shutil.rmtree(RESULTS_DIR)
    RESULTS_DIR.mkdir(parents=True)

    suites = [s.strip() for s in args.test.split(",") if s.strip()]
    # entries 保留每侧绝对路径（拷贝用）；merged 为报告用的带 suite 前缀路径。
    entries: list[tuple[str, str, str]] = []
    merged: list[asmcompare.FileDiff] = []
    for suite in suites:
        base_suite = BUILD_DIR / "asm" / "base" / suite
        opt_suite = BUILD_DIR / "asm" / "opt" / suite
        if base_suite.is_dir() and opt_suite.is_dir():
            c = asmcompare.compare(str(base_suite), str(opt_suite))
            for fd in c:
                base_abs, opt_abs = c.paths(fd)
                entries.append((f"{suite}/{fd.path}", base_abs, opt_abs))
                merged.append(asmcompare.FileDiff(f"{suite}/{fd.path}", fd.added, fd.removed))
        else:
            print(f"[warn] skipping suite '{suite}': missing asm dirs "
                  f"({base_suite if not base_suite.is_dir() else opt_suite})")
    comparison = asmcompare.Comparison(merged)
    status = "diff" if len(comparison) else "no_diff"

    # --publish-branch（可选，先于 results/ 规范布局写入；publish 会重建 results/）
    published = None
    if args.publish_branch:
        if status == "no_diff":
            print("No differences — nothing to publish as a branch.")
        else:
            if use_pr_mode(pr_id):
                label = f"LLVM PR #{pr_id}"
            else:
                label = f"branch {local_branch}"
            published = publish_branch(
                args, state, entries, label, state.get("commit_sha", "")
            )

    # 规范布局：results/{base,opt}/<suite>/<suite 内路径>
    for rel, base_abs, opt_abs in entries:
        for src, side in ((base_abs, "base"), (opt_abs, "opt")):
            dst = RESULTS_DIR / side / rel
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst)

    commit_sha = state.get("commit_sha", "")
    opt_info = get_commit_info() or get_commit_info(commit_sha)
    merge_base = state.get("merge_base", "")
    base_source = f"--base {args.base}" if args.base else f"merge-base:{main_ref()}"
    base_info = get_commit_info(merge_base) if merge_base else {}

    rd = report_mod.build_report(
        status=status,
        target={
            "kind": "pr" if pr_id else "branch",
            "pr": int(pr_id) if pr_id else None,
            "branch_name": local_branch,
        },
        base={"sha": merge_base, "source": base_source,
              "subject": base_info.get("subject", "")},
        opt={"sha": commit_sha, "short": opt_info.get("short", commit_sha[:8]),
             "author": opt_info.get("author", ""), "date": opt_info.get("date", ""),
             "subject": opt_info.get("subject", "")},
        flag=args.flag,
        suites=suites,
        started_at=state.get("started_at", ""),
        duration_seconds=sum(timings.values()),
        step_timings=dict(timings),
        comparison=comparison,
        published_branch=published,
    )
    json_path, md_path = report_mod.write(str(RESULTS_DIR), rd)

    s = rd["summary"]
    print(f"\nStatus : {status}")
    print(f"Report : {json_path}")
    print(f"         {md_path}")
    if status == "diff":
        print(f"Diff   : {s['files_changed']} files, "
              f"+{s['added']:,} / -{s['removed']:,} lines (net {s['net']:+,})")
        print("Inspect: results/base/<path> vs results/opt/<path>")
    if published:
        print(f"Branch : {published}")
    return status


def use_pr_mode(pr_id: str | None) -> bool:
    return pr_id is not None


# ── Subcommand: run ─────────────────────────────────────────────────────────


def parse_run_args(argv: list[str]):
    p = argparse.ArgumentParser(
        prog="opt-pr-cov run",
        description="Build base/opt LLVM, diff asm, write results/ (and report.json).",
    )
    p.add_argument("--pr", type=int, help="LLVM PR number")
    p.add_argument("--llvm-dir", type=Path, help="Path to llvm-project checkout (default: repos/llvm-project)")
    p.add_argument("--branch", help="Local branch name to compare (uses current branch if not set)")
    p.add_argument(
        "--base",
        help="Base commit/ref to compare against (default: merge-base of branch and upstream/main)",
    )
    p.add_argument("--flag", default="-mlsx -O3", help="Compiler flags (default: -mlsx -O3)")
    p.add_argument("--test", default="test-suite", help="Comma-separated test suites")
    p.add_argument("--fresh", action="store_true", help="Ignore cached steps, re-run all")
    p.add_argument("--publish-branch", action="store_true",
                   help="Also create a result branch with 2 commits (opt-in; default is directory-only output)")
    p.add_argument("--fail-on-no-diff", action="store_true",
                   help="Exit 1 when base and opt produce identical asm")
    p.add_argument("--verbose", action="store_true",
                   help="Stream build output to stdout as well as log files")
    args = p.parse_args(argv)
    if not args.pr and not args.branch:
        p.error("either --pr or --branch (or both) is required")
    return args


def _porcelain(path: Path, ignore_untracked: bool = False) -> str:
    cmd = f"cd '{path}' && git status --porcelain"
    if ignore_untracked:
        cmd += " --untracked-files=no"
    r = run(cmd, capture_output=True, text=True)
    return r.stdout.strip()


def cmd_run(argv: list[str]) -> int:
    args = parse_run_args(argv)
    global LLVM_SRC
    LLVM_SRC = (args.llvm_dir or LLVM_SRC).resolve()

    if not LLVM_SRC.is_dir():
        print(f"Error: LLVM source directory not found: {LLVM_SRC}", file=sys.stderr)
        return 1

    use_pr = args.pr is not None
    use_local = args.branch is not None or not use_pr
    pr_id = str(args.pr) if use_pr else None

    # llvm-project 必须干净（步骤要 checkout）；工具仓库只在发布分支时要求
    # 无 *已跟踪* 改动（results/ 未跟踪是常态，不算脏）。
    if _porcelain(LLVM_SRC):
        print(f"Error: {LLVM_SRC} has uncommitted changes. Commit or stash first.", file=sys.stderr)
        return 1
    if args.publish_branch and _porcelain(ROOT, ignore_untracked=True):
        print(f"Error: {ROOT} has uncommitted tracked changes. Commit or stash first.", file=sys.stderr)
        return 1

    local_branch = args.branch or get_current_branch()

    state, branch = runstate.init_state(
        str(STATE_DIR), pr_id, local_branch if use_local else None,
        args.flag, args.test, args.base or "", STEPS,
    )
    state.setdefault("started_at", datetime.now(timezone.utc).isoformat(timespec="seconds"))
    write_state(state)

    if args.fresh:
        if use_pr:
            print(f"Fresh run on branch '{branch}' (PR #{pr_id})")
        else:
            print(f"Fresh run on branch '{branch}' (branch: {local_branch})")
        clear_steps()

    LOG_DIR.mkdir(parents=True, exist_ok=True)

    git = GitRestore()
    git.save()

    done = {s for s in STEPS if step_done(s)}
    prog = Progress(STEPS, done)
    prog.draw()

    # Restore context persisted by earlier runs (needed when steps are skipped).
    state = read_state() or {}
    opt_branch = state.get("opt_branch")
    commit_sha = state.get("commit_sha")
    merge_base = state.get("merge_base")
    if state.get("fetch-remote") == "done" and not opt_branch:
        opt_branch = f"pr-{pr_id}-local" if use_pr else local_branch
    if opt_branch and (not commit_sha or not merge_base):
        if not commit_sha:
            r = run(f"cd '{LLVM_SRC}' && git rev-parse {opt_branch}", capture_output=True, text=True)
            commit_sha = r.stdout.strip() if r.returncode == 0 else None
        if not merge_base:
            merge_base = resolve_base_commit(opt_branch, args.base)
        if not commit_sha or not merge_base:
            print("Error: cannot recover run context from state; use --fresh to re-run.", file=sys.stderr)
            return 1

    timings: dict[str, int] = {}
    exit_code = 0
    status = None

    try:
        # ── Step 1: Fetch remote ──
        if not step_done("fetch-remote"):
            prog.draw("fetch-remote")
            t0 = time.time()
            fetch_main(args.verbose)
            if use_pr:
                opt_branch, commit_sha = fetch_pr(pr_id, args.verbose)
            else:
                r = run(f"cd '{LLVM_SRC}' && git rev-parse {local_branch}", capture_output=True, text=True)
                commit_sha = r.stdout.strip()
                opt_branch = local_branch
            timings["fetch-remote"] = int(time.time() - t0)
            print(f"\n[OK] Step 1/9: fetch-remote   ({fmt_seconds(timings['fetch-remote'])})")
            mark_step("fetch-remote", opt_branch=opt_branch, commit_sha=commit_sha)
            mark_step_done("fetch-remote", timings)

        # ── Step 2: Find merge-base ──
        if not step_done("find-merge-base"):
            prog.draw("find-merge-base")
            t0 = time.time()
            merge_base = resolve_base_commit(opt_branch, args.base)
            timings["find-merge-base"] = int(time.time() - t0)
            note = " (--base)" if args.base else ""
            print(f"\n[OK] Step 2/9: find-merge-base{note} "
                  f"({fmt_seconds(timings['find-merge-base'])}) — {merge_base[:8]}")
            mark_step("find-merge-base", merge_base=merge_base)
            mark_step_done("find-merge-base", timings)

        # ── Step 3: Checkout base ──
        # Always enforce the tree position: a previous run's failure restored
        # the worktree via GitRestore, so a cached "done" marker does not
        # guarantee the sources actually sit at the merge base.
        prog.draw("checkout-base")
        t0 = time.time()
        r = run(f"cd '{LLVM_SRC}' && git rev-parse HEAD", capture_output=True, text=True)
        prev_head = r.stdout.strip()
        check(f"cd '{LLVM_SRC}' && git checkout {merge_base}")
        if prev_head != merge_base and (step_done("build-llvm-base") or step_done("build-ts-base")):
            print("\n[..] tree moved since cached base build — invalidating base build cache")
            s = read_state() or {}
            for st in ("build-llvm-base", "build-ts-base"):
                s.pop(st, None)
                done.discard(st)
            write_state(s)
        timings["checkout-base"] = int(time.time() - t0)
        mark_step("checkout-base")
        mark_step_done("checkout-base", timings)

        # ── Step 4: Build LLVM (base) ──
        if not step_done("build-llvm-base"):
            prog.draw("build-llvm-base")
            t0 = time.time()
            step_build_llvm("base", args.verbose)
            timings["build-llvm-base"] = int(time.time() - t0)
            print(f"\n[OK] Step 4/9: build-llvm-base ({fmt_seconds(timings['build-llvm-base'])})")
            mark_step("build-llvm-base")
            mark_step_done("build-llvm-base", timings)

        # ── Step 5: Build test suites (base) ──
        if not step_done("build-ts-base"):
            prog.draw("build-ts-base")
            t0 = time.time()
            step_build_ts("base", args.flag, args.test, args.verbose)
            timings["build-ts-base"] = int(time.time() - t0)
            print(f"\n[OK] Step 5/9: build-ts-base   ({fmt_seconds(timings['build-ts-base'])})")
            mark_step("build-ts-base")
            mark_step_done("build-ts-base", timings)

        # ── Step 6: Checkout opt ──
        # Always enforce the tree position (same reasoning as step 3).
        prog.draw("checkout-opt")
        t0 = time.time()
        r = run(f"cd '{LLVM_SRC}' && git rev-parse HEAD", capture_output=True, text=True)
        prev_head = r.stdout.strip()
        check(f"cd '{LLVM_SRC}' && git checkout {opt_branch}")
        if prev_head != commit_sha and (step_done("build-llvm-opt") or step_done("build-ts-opt")):
            print("\n[..] tree moved since cached opt build — invalidating opt build cache")
            s = read_state() or {}
            for st in ("build-llvm-opt", "build-ts-opt"):
                s.pop(st, None)
                done.discard(st)
            write_state(s)
        timings["checkout-opt"] = int(time.time() - t0)
        mark_step("checkout-opt")
        mark_step_done("checkout-opt", timings)

        # ── Step 7: Build LLVM (opt) ──
        if not step_done("build-llvm-opt"):
            prog.draw("build-llvm-opt")
            t0 = time.time()
            step_build_llvm("opt", args.verbose)
            timings["build-llvm-opt"] = int(time.time() - t0)
            print(f"\n[OK] Step 7/9: build-llvm-opt  ({fmt_seconds(timings['build-llvm-opt'])})")
            mark_step("build-llvm-opt")
            mark_step_done("build-llvm-opt", timings)

        # ── Step 8: Build test suites (opt) ──
        if not step_done("build-ts-opt"):
            prog.draw("build-ts-opt")
            t0 = time.time()
            step_build_ts("opt", args.flag, args.test, args.verbose)
            timings["build-ts-opt"] = int(time.time() - t0)
            print(f"\n[OK] Step 8/9: build-ts-opt    ({fmt_seconds(timings['build-ts-opt'])})")
            mark_step("build-ts-opt")
            mark_step_done("build-ts-opt", timings)

        # ── Step 9: Create results ──
        if not step_done("create-results"):
            prog.draw("create-results")
            t0 = time.time()
            status = create_results(args, timings, pr_id, local_branch)
            timings["create-results"] = int(time.time() - t0)
            print(f"\n[OK] Step 9/9: create-results  ({fmt_seconds(timings['create-results'])})")
            mark_step("create-results")
            mark_step_done("create-results", timings)
            if status == "no_diff" and args.fail_on_no_diff:
                print("\n--fail-on-no-diff: no differences found, exiting 1", file=sys.stderr)
                exit_code = 1

        print(f"\nAll steps complete.{' Results: ' + str(RESULTS_DIR) if status != 'no_diff' else ' (no differences)'}")

    except StepFailure as e:
        exit_code = 1
        print(f"\nFAILED (exit {e.returncode}): {e.cmd}", file=sys.stderr)
        print(f"Log: {e.log_path}", file=sys.stderr)
        if e.tail:
            print("--- last lines ---", file=sys.stderr)
            for line in e.tail:
                print(line, file=sys.stderr)
    except subprocess.CalledProcessError as e:
        exit_code = 1
        print(f"\nBuild failed at step '{e.cmd}' (exit {e.returncode})", file=sys.stderr)
    except (ValueError, RuntimeError) as e:
        exit_code = 1
        print(f"\nError: {e}", file=sys.stderr)
    finally:
        git.restore()

    return exit_code


# ── Subcommand: status ──────────────────────────────────────────────────────


def cmd_status() -> int:
    state = read_state()
    if not state:
        print("No run state found. Start one with:")
        print("  ./opt-pr-cov run --pr <N>     (or --branch <name>)")
        return 0

    done = [s for s in STEPS if state.get(s) == "done"]
    pending = [s for s in STEPS if s not in done]
    identity = state.get("identity", "?")

    print(f"Run        : {identity}")
    if state.get("pr"):
        print(f"  LLVM PR  : #{state['pr']}")
    if state.get("branch_name"):
        print(f"  Branch   : {state['branch_name']}")
    print(f"Flag/Test  : {state.get('flag', '?')} | {state.get('test', '?')}")
    if state.get("base"):
        print(f"Base ref   : {state['base']} (--base)")
    if state.get("commit_sha"):
        print(f"Opt SHA    : {state['commit_sha'][:12]}")
    if state.get("merge_base"):
        print(f"Base SHA   : {state['merge_base'][:12]}")
    print(f"Steps      : {len(done)}/{len(STEPS)} done")
    for s in STEPS:
        mark = "x" if state.get(s) == "done" else " "
        d = state.get(f"dur_{s}")
        extra = f" ({fmt_seconds(int(d))})" if d else ""
        print(f"  [{mark}] {s}{extra}")
    if pending:
        print(f"Next       : {pending[0]}")
        print("Resume     : ./opt-pr-cov run  (re-run the same command; cached steps are skipped)")

    rp = RESULTS_DIR / "report.json"
    if rp.exists():
        try:
            rd = json.loads(rp.read_text())
            s = rd.get("summary", {})
            print(f"Results    : {rp}")
            print(f"  status={rd.get('status')} files={s.get('files_changed')} "
                  f"+{s.get('added', 0):,} / -{s.get('removed', 0):,} "
                  f"({rd.get('started_at') or '?'})")
            if rd.get("published_branch"):
                print(f"  branch={rd['published_branch']}")
        except (json.JSONDecodeError, OSError) as e:
            print(f"Results    : {rp} (unreadable: {e})")
    else:
        print("Results    : none yet (results/report.json appears after the final step)")
    print(f"Logs       : {LOG_DIR}")
    return 0


# ── Subcommand: report ──────────────────────────────────────────────────────


def cmd_report() -> int:
    rp = RESULTS_DIR / "report.json"
    if not rp.exists():
        print(f"Error: {rp} not found. Run a comparison first:", file=sys.stderr)
        print("  ./opt-pr-cov run --pr <N>", file=sys.stderr)
        return 1
    try:
        rd = json.loads(rp.read_text())
    except json.JSONDecodeError as e:
        print(f"Error: {rp} is not valid JSON: {e}", file=sys.stderr)
        return 1
    md_path = RESULTS_DIR / "report.md"
    md_path.write_text(report_mod.render_markdown(rd))
    print(f"Rendered {md_path} (status={rd.get('status')}, "
          f"{rd.get('summary', {}).get('files_changed', 0)} files)")
    return 0


# ── Main ────────────────────────────────────────────────────────────────────


def main() -> None:
    argv = sys.argv[1:]
    if argv and argv[0] in SUBCOMMANDS:
        cmd, rest = argv[0], argv[1:]
    else:
        # Backward compat: bare flags imply `run` (e.g. ./opt-pr-cov --pr 12345)
        cmd, rest = "run", argv

    if cmd == "status":
        sys.exit(cmd_status())
    if cmd == "report":
        sys.exit(cmd_report())
    sys.exit(cmd_run(rest))


if __name__ == "__main__":
    main()
