 (static_cast<void> (0));



 *ioNumBytes = outputSize;



 mTotalBytesGenerated += outputSize;
 mMaxFrameBytes = ( (mMaxFrameBytes)>(outputSize) ?(mMaxFrameBytes): (outputSize) );

 status = ALAC_noErr;

Exit:
