     }


     set_ag_params( &agParams, mConfig.mb, (pb * pbFactorV) / 4, mConfig.kb, numSamples, numSamples, mConfig.maxRun );
     status = dyn_decomp( &agParams, bits, mPredictor, numSamples, chanBits, &bits2 );
     if ((status)) { goto Exit; };

