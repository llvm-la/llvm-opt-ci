  return;
 if(conv->priority == BOM && prio == NOBOM_AUTODETECT)
  return;

 tmp_encoding = normalize_encoding(encoding);
 if(prio == META) {
 old_size = encoding_bytes(conv->encoding,&tmp);
 new_size = encoding_bytes(tmp_encoding,&tmp);
