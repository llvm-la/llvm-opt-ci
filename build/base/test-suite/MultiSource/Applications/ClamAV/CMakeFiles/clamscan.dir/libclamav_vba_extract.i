 for (i=0 ; i < macro_info->count ; i++) {
  if (!wm_read_macro_entry(fd,
    &macro_info->macro_entry[i])) {
   wm_free_macro_info(macro_info);
   return ((void*)0);
  }
 }
 return macro_info;
}

