 }

 if (!vba_read_project_strings(fd, is_mac)) {
  close(fd);
  return ((void*)0);
 }


 do {
  if (cli_readn(fd, &ffff, 2) != 2) {
   close(fd);
   return ((void*)0);
  }
 } while(ffff != 0xFFFF);


 lseek(fd, -3, 1);
 if (cli_readn(fd, &ffff, 2) != 2) {
  close(fd);
  return ((void*)0);
 }
 if (ffff != 0xFFFF) {
  lseek(fd, 1, 1);
 }

 if (cli_readn(fd, &ffff, 2) != 2) {
  close(fd);
  return ((void*)0);
 }


 if (ffff != 0xFFFF) {
  ffff = vba_endian_convert_16(ffff, is_mac);
  lseek(fd, ffff, 1);
 }
 if (cli_readn(fd, &ffff, 2) != 2) {
  close(fd);
  return ((void*)0);
 }
 if (ffff != 0xFFFF) {
  ffff = vba_endian_convert_16(ffff, is_mac);
  lseek(fd, ffff, 1);
 }
 lseek(fd, 100, 1);

 if (cli_readn(fd, &record_count, 2) != 2) {
  close(fd);
  return ((void*)0);
 }
 record_count = vba_endian_convert_16(record_count, is_mac);
