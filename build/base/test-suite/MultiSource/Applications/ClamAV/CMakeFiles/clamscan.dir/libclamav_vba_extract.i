  return (0);
 }
 count = vba_endian_convert_16(count, (0));
 cli_dbgmsg("menu_info count: %d\n", count);

 if(count)
  if(lseek(fd, count * 12, 1) == -1)
   return (0);
 return (1);
}

static int
wm_skip_macro_extnames(int fd)
{
 int is_unicode;
 int16_t size;
 off_t offset_end = lseek(fd, 0, 1);

 if(cli_readn(fd, &size, sizeof(int16_t)) != sizeof(int16_t)) {
  cli_dbgmsg("read macro_extnames failed\n");
  return (0);
 }
 size = vba_endian_convert_16(size, (0));
 if (size == -1) {
  if(cli_readn(fd, &size, sizeof(int16_t)) != sizeof(int16_t)) {
   cli_dbgmsg("read macro_extnames failed\n");
   return (0);
  }
  size = vba_endian_convert_16(size, (0));
  is_unicode = 1;
 } else
  is_unicode = 0;

 cli_dbgmsg("ext names size: 0x%x\n", size);

 offset_end += size;
 while(lseek(fd, 0, 1) < offset_end) {
  uint8_t length;
  off_t offset;

  if (cli_readn(fd, &length, 1) != 1) {
   cli_dbgmsg("read macro_extnames failed\n");
   return (0);
  }

  if(is_unicode)
   offset = (off_t)length * 2 + 1;
  else
   offset = (off_t)length;

  offset += sizeof(uint16_t);
  if(lseek(fd, offset, 1) == -1) {
   cli_dbgmsg("read macro_extnames failed to seek\n");
   return (0);
  }
 }
 return (1);
}

