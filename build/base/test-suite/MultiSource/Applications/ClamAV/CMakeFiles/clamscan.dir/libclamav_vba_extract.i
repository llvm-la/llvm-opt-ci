 }
 vba_project->name = (char **) cli_malloc(sizeof(char *) * record_count);
 if (!vba_project->name) {
  free(vba_project);
  close(fd);
  return ((void*)0);
 }
 vba_project->dir = cli_strdup(dir);
 vba_project->offset = (uint32_t *) cli_malloc (sizeof(uint32_t) *
