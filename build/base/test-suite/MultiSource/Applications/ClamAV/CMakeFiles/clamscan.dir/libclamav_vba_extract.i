 unsigned char *ret;
 unsigned char buffer[4096];

 b = blobCreate();

 if(b == ((void*)0))
  return ((void*)0);

 lseek(fd, offset+3, 0);

 while (cli_readn(fd, &flag, 1) == 1) {
  for (mask = 1; mask < 0x100; mask<<=1) {
   if (flag & mask) {
    if (cli_readn(fd, &token, 2) != 2) {
     blobDestroy(b);
     if (size) {
      *size = 0;
     }
     return ((void*)0);
    }
    token = vba_endian_convert_16(token, (0));
    win_pos = pos % 4096;
    if (win_pos <= 0x80) {
     if (win_pos <= 0x20) {
      shift = (win_pos <= 0x10) ? 12:11;
     } else {
      shift = (win_pos <= 0x40) ? 10:9;
     }
    } else {
     if (win_pos <= 0x200) {
      shift = (win_pos <= 0x100) ? 8:7;
     } else if (win_pos <= 0x800) {
      shift = (win_pos <= 0x400) ? 6:5;
     } else {
      shift = 4;
     }
    }
    len = (uint16_t)((token & ((1 << shift) -1)) + 3);
    distance = token >> shift;
    clean = (1);

    for (i=0 ; i < len; i++) {
     unsigned int srcpos;
     unsigned char c;

     srcpos = (pos - distance - 1) % 4096;
     c = buffer[srcpos];
     buffer[pos++ % 4096]= c;
    }
   } else {
    if ((pos != 0) &&
     ((pos % 4096) == 0) && clean) {

     if (cli_readn(fd, &token, 2) != 2) {
      blobDestroy(b);
      if(size)
             *size = 0;
      return ((void*)0);
     }
     clean = (0);
     (void)blobAddData(b, buffer, 4096);
     break;
    }
    if (cli_readn(fd, buffer+(pos%4096), 1) == 1){
     pos++;
    }
    clean = (1);
   }
  }
 }

 if (pos % 4096)
  if(blobAddData(b, buffer, pos%4096) < 0) {
   if(size)
          *size = 0;
   blobDestroy(b);
   return ((void*)0);
  }
 s = blobGetDataSize(b);
 ret = cli_malloc(s);
 if(ret == ((void*)0)) {
  blobDestroy(b);
  if(size)
         *size = 0;
  return ((void*)0);
 }
 if(size)
  *size = (int)s;
 memcpy(ret, blobGetData(b), s);
 blobDestroy(b);
 return ret;
}

static uint32_t ole_copy_file_data(int ifd, int ofd, uint32_t len)
{
        unsigned int count, rem;
        unsigned char data[8192];

        rem = len;

        while (rem > 0) {
                unsigned int todo = (((sizeof(data))<(rem))?(sizeof(data)):(rem));

                count = cli_readn(ifd, data, todo);
                if (count != todo) {
                        return len-rem;
                }
                if((unsigned int)cli_writen(ofd, data, count) != count)
                        return len-rem-count;
                rem -= count;
        }
        return len;
}

int cli_decode_ole_object(int fd, const char *dir)
{
 int ofd;
 struct stat statbuf;
 char ch;
 uint32_t object_size;
 char fullname[256 + 1];

 if (fstat(fd, &statbuf) == -1) {
  return -1;
 }

 if (cli_readn(fd, &object_size, 4) != 4) {
  return -1;
 }
 object_size = vba_endian_convert_32(object_size, (0));

 if ((statbuf.st_size - object_size) >= 4) {

  if (lseek(fd, 2, 1) == -1) {
   return -1;
  }


  do {
   if (cli_readn(fd, &ch, 1) != 1) {
    return -1;
   }
  } while (ch);


  do {
   if (cli_readn(fd, &ch, 1) != 1) {
    return -1;
   }
  } while (ch);


  if (lseek(fd, 8, 1) == -1) {
   return -1;
  }


  do {
   if (cli_readn(fd, &ch, 1) != 1) {
    return -1;
   }
  } while (ch);

  if (cli_readn(fd, &object_size, 4) != 4) {
   return -1;
  }
  object_size = vba_endian_convert_32(object_size, (0));
 }
 snprintf(fullname, sizeof(fullname) - 1, "%s/_clam_ole_object", dir);
 ofd = open(fullname, 02|0100|01000|0, 0600);
 if (ofd < 0) {
  return -1;
 }
 ole_copy_file_data(fd, ofd, object_size);
 lseek(ofd, 0, 0);
 return ofd;
}





typedef struct atom_header_tag {
 off_t foffset;
 uint16_t ver_inst;
 uint8_t version;
 uint16_t instance;
 uint16_t type;
 uint32_t length;
} atom_header_t;

static int ppt_read_atom_header(int fd, atom_header_t *atom_header)
{
 atom_header->foffset = lseek(fd, 0, 1);
 if (cli_readn(fd, &atom_header->ver_inst, 2) != 2) {
  cli_dbgmsg("read ppt_current_user failed\n");
  return (0);
 }
 atom_header->ver_inst = vba_endian_convert_16(atom_header->ver_inst, (0));
 atom_header->version = (uint8_t)(atom_header->ver_inst & 0x000f);
 atom_header->instance = (uint16_t)(atom_header->ver_inst >> 4);
 if(cli_readn(fd, &atom_header->type, sizeof(uint16_t)) != sizeof(uint16_t)) {
  cli_dbgmsg("read ppt_current_user failed\n");
  return (0);
 }
 if (cli_readn(fd, &atom_header->length, 4) != 4) {
  cli_dbgmsg("read ppt_current_user failed\n");
  return (0);
 }
 atom_header->type = vba_endian_convert_16(atom_header->type, (0));
 atom_header->length = vba_endian_convert_32(atom_header->length, (0));
 return (1);
}

static void ppt_print_atom_header(atom_header_t *atom_header)
{
 cli_dbgmsg("Atom Hdr:\n");
 cli_dbgmsg("  Version: 0x%.2x\n", atom_header->version);
 cli_dbgmsg("  Instance: 0x%.4x\n", atom_header->instance);
 cli_dbgmsg("  Type: 0x%.4x\n", atom_header->type);
 cli_dbgmsg("  Length: 0x%.8x\n", atom_header->length);
}

static int ppt_unlzw(const char *dir, int fd, uint32_t length)
{
 int ofd, retval;
 unsigned char inbuff[8192], outbuff[8192];
 uint32_t bufflen;
 z_stream stream;
 char fullname[256 + 1];

 snprintf(fullname, sizeof(fullname) - 1, "%s/ppt%.8lx.doc",
  dir, (long)lseek(fd, 0L, 1));

 ofd = open(fullname, 01|0100|01000|0, 0600);
 if (ofd == -1) {
  cli_dbgmsg("ppt_unlzw Open outfile failed\n");
  return (0);
 }

 stream.zalloc = 0;
 stream.zfree = 0;
 stream.opaque = (void *)0;

 stream.next_in = inbuff;
 bufflen = stream.avail_in = (((length)<(8192))?(length):(8192));

 if (cli_readn(fd, inbuff, stream.avail_in) != (int64_t)stream.avail_in) {
  close(ofd);
  unlink(fullname);
  return (0);
 }
 length -= stream.avail_in;

 retval = inflateInit_((&stream), "1.2.11", (int)sizeof(z_stream));
 if (retval != 0) {
  cli_dbgmsg(" ppt_unlzw !Z_OK: %d\n", retval);
 }

 stream.next_out = outbuff;
 stream.avail_out = 8192;

 do {
  if (stream.avail_out == 0) {
   if (cli_writen(ofd, outbuff, 8192)
      != 8192) {
    close(ofd);
    inflateEnd(&stream);
    return (0);
   }
   stream.next_out = outbuff;
   stream.avail_out = 8192;
  }
  if (stream.avail_in == 0) {
   stream.next_in = inbuff;
   bufflen = stream.avail_in = (((length)<(8192))?(length):(8192));
   if (cli_readn(fd, inbuff, stream.avail_in) != (int64_t)stream.avail_in) {
    close(ofd);
    inflateEnd(&stream);
    return (0);
   }
   length -= stream.avail_in;
  }
  retval = inflate(&stream, 0);
 } while (retval == 0);

 if (cli_writen(ofd, outbuff, bufflen) != (int64_t)bufflen) {
  close(ofd);
  inflateEnd(&stream);
  return (0);
 }
 inflateEnd(&stream);
 return close(ofd);
}

static char *ppt_stream_iter(int fd)
{
 uint32_t ole_id;
 char *out_dir;
 off_t offset;
 atom_header_t atom_header;


 out_dir = cli_gentemp(((void*)0));
 if(mkdir(out_dir, 0700)) {
  cli_errmsg("ScanOLE2 -> Can't create temporary directory %s\n", out_dir);
  free(out_dir);
  return ((void*)0);
 }

 while(ppt_read_atom_header(fd, &atom_header)) {
  ppt_print_atom_header(&atom_header);

  if (atom_header.length == 0) {
   cli_rmdirs(out_dir);
   free(out_dir);
   return ((void*)0);
  }

  if (atom_header.type == 0x1011) {
   if (cli_readn(fd, &ole_id, 4) != 4) {
    cli_dbgmsg("read ole_id failed\n");
    cli_rmdirs(out_dir);
    free(out_dir);
    return ((void*)0);
   }
   ole_id = vba_endian_convert_32(ole_id, (0));
   cli_dbgmsg("OleID: %d, length: %d\n",
     (int)ole_id, (int)atom_header.length-4);
   if (!ppt_unlzw(out_dir, fd, atom_header.length-4)) {
    cli_dbgmsg("ppt_unlzw failed\n");
    cli_rmdirs(out_dir);
    free(out_dir);
    return ((void*)0);
   }

  } else {
   offset = lseek(fd, 0, 1);

   if ((offset + (off_t)atom_header.length) < offset) {
    break;
   }
   offset += atom_header.length;
   if (lseek(fd, offset, 0) != offset ) {
    break;
   }
  }
 }
 return out_dir;
}

char *ppt_vba_read(const char *dir)
{
 char *out_dir;
 int fd;
 char fullname[256 + 1];

 snprintf(fullname, sizeof(fullname) - 1, "%s/PowerPoint Document", dir);
 fd = open(fullname, 00|0);
 if (fd == -1) {
  cli_dbgmsg("Open PowerPoint Document failed\n");
  return ((void*)0);
 }

 out_dir = ppt_stream_iter(fd);
 close(fd);
 return out_dir;
}






