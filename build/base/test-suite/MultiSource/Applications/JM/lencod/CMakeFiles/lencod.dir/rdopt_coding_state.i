  {


    for (i = 0; i < i_last; i++)
    {

      *currSlice->partArr[i].bitstream = cs->bitstream[i];
    }
  }


  memcpy (currMB->bitcounter, cs->bitcounter, MAX_BITCOUNTER_MB * sizeof(int));


  memcpy (currMB->mvd, cs->mvd, 64 * sizeof(int));
  currMB->cbp_bits = cs->cbp_bits;
}
