void
impl_storageclasses::do_unparse(printer_functor kc_printer, uview kc_current_view_base)
{
    if(is_nil())
 nil_do_unparse(kc_printer, kc_current_view_base);
    else
 switch(kc_current_view_base) {
 case view_gen_operatordefs_c_2_enum: {
