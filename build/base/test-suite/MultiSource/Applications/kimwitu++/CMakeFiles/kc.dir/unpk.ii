  kc::unparse(r_sc, kc_printer, kc_current_view);
  if (this->phyla->length() > 0)
  {
      { kc_printer("static enum_phyla phylumstorageclass_", kc_current_view); }
      kc::unparse(sc, kc_printer, kc_current_view);
      { kc_printer("[] = { one_before_first_phylum, ", kc_current_view); }
      kc::unparse(this->phyla, kc_printer, kc_current_view);
      { kc_printer("last_phylum };\n", kc_current_view); }

  }
     }
