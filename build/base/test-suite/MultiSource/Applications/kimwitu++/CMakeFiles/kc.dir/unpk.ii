  dollarvarsallowed.push( DVAllowed() );
  phylumstack.push( i );

  kc::unparse(cco, kc_printer, kc_current_view);
  outmostoperators.top()->freelist();
  outmostoperators.pop();
  dollarvarsallowed.pop();
  phylumstack.pop();

     }
