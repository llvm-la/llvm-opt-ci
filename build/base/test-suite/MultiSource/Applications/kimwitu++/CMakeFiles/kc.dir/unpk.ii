  variablesstack.pop(); variablesstack.push( tmp );
  v_extendoccur( v, ITPatternVariable( f_phylumofoutmostpattern( p ),
   mkinteger(cl_scope)));

  kc::unparse(p, kc_printer, kc_current_view);
