UInt64 g_Crc64Table[256];

void Crc64GenerateTable(void)
{
  UInt32 i;
  for (i = 0; i < 256; i++)
  {
    UInt64 r = i;
    int j;
    for (j = 0; j < 8; j++)
      r = (r >> 1) ^ ((UInt64)0xC96C5795D7870F42ULL & ~((r & 1) - 1));
    g_Crc64Table[i] = r;
  }
}

UInt64 Crc64Update(UInt64 v, const void *data, size_t size)
{
  const Byte *p = (const Byte *)data;
  for (; size > 0 ; size--, p++)
    v = (g_Crc64Table[((v) ^ (*p)) & 0xFF] ^ ((v) >> 8));
  return v;
}

UInt64 Crc64Calc(const void *data, size_t size)
{
  return ((Crc64Update(0xFFFFFFFFFFFFFFFFULL, data, size)) ^ 0xFFFFFFFFFFFFFFFFULL);
}
