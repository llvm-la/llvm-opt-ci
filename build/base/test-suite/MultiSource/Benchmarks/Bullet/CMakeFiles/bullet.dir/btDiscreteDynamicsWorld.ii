struct btDiscreteCollisionDetectorInterface
{

 struct Result
 {

  virtual ~Result(){}


  virtual void setShapeIdentifiersA(int partId0,int index0)=0;
  virtual void setShapeIdentifiersB(int partId1,int index1)=0;
