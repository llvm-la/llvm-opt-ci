    {
     if(axis<3)
     {
      m_linearLimits.m_lowerLimit[axis] = lo;
      m_linearLimits.m_upperLimit[axis] = hi;
     }
     else
     {
   lo = btNormalizeAngle(lo);
   hi = btNormalizeAngle(hi);
      m_angularLimits[axis-3].m_loLimit = lo;
      m_angularLimits[axis-3].m_hiLimit = hi;
     }
    }
