 }
 vector = swappedVec;
}

inline void btPlaneSpace1 (const btVector3& n, btVector3& p, btVector3& q)
{
  if (btFabs(n.z()) > btScalar(0.7071067811865475244008443621048490)) {

    btScalar a = n[1]*n[1] + n[2]*n[2];
    btScalar k = ((btScalar)(btScalar(1.0)/btSqrt(btScalar(a))));
    p.setValue(0,-n[2]*k,n[1]*k);

    q.setValue(a*k,-n[0]*p[2],n[0]*p[1]);
  }
  else {

    btScalar a = n.x()*n.x() + n.y()*n.y();
    btScalar k = ((btScalar)(btScalar(1.0)/btSqrt(btScalar(a))));
    p.setValue(-n.y()*k,n.x()*k,0);

    q.setValue(-n.z()*p.y(),n.z()*p.x(),a*k);
  }
}
