inline void btSwapScalarEndian(const btScalar& sourceVal, btScalar& destVal)
{
# 610 "/home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/repos/llvm-test-suite/MultiSource/Benchmarks/Bullet/include/LinearMath/btVector3.h"
