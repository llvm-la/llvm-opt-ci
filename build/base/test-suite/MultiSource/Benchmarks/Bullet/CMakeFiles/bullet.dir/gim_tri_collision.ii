template<typename T>
inline void SORT_3_INDICES(
  const T * values,
  unsigned int * order_indices)
{

 order_indices[0] = values[0] < values[1] ? (values[0] < values[2] ? 0 : 2) : (values[1] < values[2] ? 1 : 2);


 unsigned int i0 = (order_indices[0] + 1)%3;
 unsigned int i1 = (i0 + 1)%3;

 if(values[i0] < values[i1])
 {
  order_indices[1] = i0;
  order_indices[2] = i1;
 }
 else
 {
  order_indices[1] = i1;
  order_indices[2] = i0;
 }
}
