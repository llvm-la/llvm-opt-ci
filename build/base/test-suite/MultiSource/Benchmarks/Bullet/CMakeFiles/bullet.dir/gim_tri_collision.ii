  return s;
 }


 btVector3 getAxis() const
 {
  btScalar s_squared = btScalar(1.) - btPow(m_floats[3], btScalar(2.));
  if (s_squared < btScalar(10.) * 1.19209290e-7F)
   return btVector3(1.0, 0.0, 0.0);
