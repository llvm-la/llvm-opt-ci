class GIM_BOX_BOX_TRANSFORM_CACHE
{
public:
    btVector3 m_T1to0;
 btMatrix3x3 m_R1to0;
 btMatrix3x3 m_AR;

 inline void calc_absolute_matrix()
 {
  static const btVector3 vepsi(1e-6f,1e-6f,1e-6f);
  m_AR[0] = vepsi + m_R1to0[0].absolute();
  m_AR[1] = vepsi + m_R1to0[1].absolute();
  m_AR[2] = vepsi + m_R1to0[2].absolute();
 }

 GIM_BOX_BOX_TRANSFORM_CACHE()
 {
 }


 GIM_BOX_BOX_TRANSFORM_CACHE(mat4f trans1_to_0)
 {
  { m_R1to0[0][0] = trans1_to_0[0][0]; m_R1to0[0][1] = trans1_to_0[0][1]; m_R1to0[0][2] = trans1_to_0[0][2]; m_R1to0[1][0] = trans1_to_0[1][0]; m_R1to0[1][1] = trans1_to_0[1][1]; m_R1to0[1][2] = trans1_to_0[1][2]; m_R1to0[2][0] = trans1_to_0[2][0]; m_R1to0[2][1] = trans1_to_0[2][1]; m_R1to0[2][2] = trans1_to_0[2][2]; }
        { m_T1to0[0] = trans1_to_0[0][3]; m_T1to0[1] = trans1_to_0[1][3]; m_T1to0[2] = trans1_to_0[2][3]; }
  calc_absolute_matrix();
 }


 inline void calc_from_homogenic(const btTransform & trans0,const btTransform & trans1)
 {

  m_R1to0 = trans0.getBasis().transpose();
  m_T1to0 = m_R1to0 * (-trans0.getOrigin());

  m_T1to0 += m_R1to0*trans1.getOrigin();
  m_R1to0 *= trans1.getBasis();

  calc_absolute_matrix();
 }


 inline void calc_from_full_invert(const btTransform & trans0,const btTransform & trans1)
 {
  m_R1to0 = trans0.getBasis().inverse();
  m_T1to0 = m_R1to0 * (-trans0.getOrigin());

  m_T1to0 += m_R1to0*trans1.getOrigin();
  m_R1to0 *= trans1.getBasis();

  calc_absolute_matrix();
 }

 inline btVector3 transform(const btVector3 & point)
 {
  return btVector3(m_R1to0[0].dot(point) + m_T1to0.x(),
   m_R1to0[1].dot(point) + m_T1to0.y(),
   m_R1to0[2].dot(point) + m_T1to0.z());
 }
};





class GIM_AABB
{
public:
 btVector3 m_min;
 btVector3 m_max;

 GIM_AABB()
 {}


 GIM_AABB(const btVector3 & V1,
    const btVector3 & V2,
    const btVector3 & V3)
 {
  m_min[0] = (V1[0]>(V2[0]>V3[0]?V3[0]:V2[0])?(V2[0]>V3[0]?V3[0]:V2[0]):V1[0]);
  m_min[1] = (V1[1]>(V2[1]>V3[1]?V3[1]:V2[1])?(V2[1]>V3[1]?V3[1]:V2[1]):V1[1]);
  m_min[2] = (V1[2]>(V2[2]>V3[2]?V3[2]:V2[2])?(V2[2]>V3[2]?V3[2]:V2[2]):V1[2]);

  m_max[0] = (V1[0]<(V2[0]<V3[0]?V3[0]:V2[0])?(V2[0]<V3[0]?V3[0]:V2[0]):V1[0]);
  m_max[1] = (V1[1]<(V2[1]<V3[1]?V3[1]:V2[1])?(V2[1]<V3[1]?V3[1]:V2[1]):V1[1]);
  m_max[2] = (V1[2]<(V2[2]<V3[2]?V3[2]:V2[2])?(V2[2]<V3[2]?V3[2]:V2[2]):V1[2]);
 }

 GIM_AABB(const btVector3 & V1,
    const btVector3 & V2,
    const btVector3 & V3,
    btScalar margin)
 {
  m_min[0] = (V1[0]>(V2[0]>V3[0]?V3[0]:V2[0])?(V2[0]>V3[0]?V3[0]:V2[0]):V1[0]);
  m_min[1] = (V1[1]>(V2[1]>V3[1]?V3[1]:V2[1])?(V2[1]>V3[1]?V3[1]:V2[1]):V1[1]);
  m_min[2] = (V1[2]>(V2[2]>V3[2]?V3[2]:V2[2])?(V2[2]>V3[2]?V3[2]:V2[2]):V1[2]);

  m_max[0] = (V1[0]<(V2[0]<V3[0]?V3[0]:V2[0])?(V2[0]<V3[0]?V3[0]:V2[0]):V1[0]);
  m_max[1] = (V1[1]<(V2[1]<V3[1]?V3[1]:V2[1])?(V2[1]<V3[1]?V3[1]:V2[1]):V1[1]);
  m_max[2] = (V1[2]<(V2[2]<V3[2]?V3[2]:V2[2])?(V2[2]<V3[2]?V3[2]:V2[2]):V1[2]);

  m_min[0] -= margin;
  m_min[1] -= margin;
  m_min[2] -= margin;
  m_max[0] += margin;
  m_max[1] += margin;
  m_max[2] += margin;
 }

 GIM_AABB(const GIM_AABB &other):
  m_min(other.m_min),m_max(other.m_max)
 {
 }

 GIM_AABB(const GIM_AABB &other,btScalar margin ):
  m_min(other.m_min),m_max(other.m_max)
 {
  m_min[0] -= margin;
  m_min[1] -= margin;
  m_min[2] -= margin;
  m_max[0] += margin;
  m_max[1] += margin;
  m_max[2] += margin;
 }

 inline void invalidate()
 {
  m_min[0] = 3.40282347e+38F;
  m_min[1] = 3.40282347e+38F;
  m_min[2] = 3.40282347e+38F;
  m_max[0] = -3.40282347e+38F;
  m_max[1] = -3.40282347e+38F;
  m_max[2] = -3.40282347e+38F;
 }

 inline void increment_margin(btScalar margin)
 {
  m_min[0] -= margin;
  m_min[1] -= margin;
  m_min[2] -= margin;
  m_max[0] += margin;
  m_max[1] += margin;
  m_max[2] += margin;
 }

 inline void copy_with_margin(const GIM_AABB &other, btScalar margin)
 {
  m_min[0] = other.m_min[0] - margin;
  m_min[1] = other.m_min[1] - margin;
  m_min[2] = other.m_min[2] - margin;

  m_max[0] = other.m_max[0] + margin;
  m_max[1] = other.m_max[1] + margin;
  m_max[2] = other.m_max[2] + margin;
 }

 template<typename CLASS_POINT>
 inline void calc_from_triangle(
       const CLASS_POINT & V1,
       const CLASS_POINT & V2,
       const CLASS_POINT & V3)
 {
  m_min[0] = (V1[0]>(V2[0]>V3[0]?V3[0]:V2[0])?(V2[0]>V3[0]?V3[0]:V2[0]):V1[0]);
  m_min[1] = (V1[1]>(V2[1]>V3[1]?V3[1]:V2[1])?(V2[1]>V3[1]?V3[1]:V2[1]):V1[1]);
  m_min[2] = (V1[2]>(V2[2]>V3[2]?V3[2]:V2[2])?(V2[2]>V3[2]?V3[2]:V2[2]):V1[2]);

  m_max[0] = (V1[0]<(V2[0]<V3[0]?V3[0]:V2[0])?(V2[0]<V3[0]?V3[0]:V2[0]):V1[0]);
  m_max[1] = (V1[1]<(V2[1]<V3[1]?V3[1]:V2[1])?(V2[1]<V3[1]?V3[1]:V2[1]):V1[1]);
  m_max[2] = (V1[2]<(V2[2]<V3[2]?V3[2]:V2[2])?(V2[2]<V3[2]?V3[2]:V2[2]):V1[2]);
 }

 template<typename CLASS_POINT>
 inline void calc_from_triangle_margin(
       const CLASS_POINT & V1,
       const CLASS_POINT & V2,
       const CLASS_POINT & V3, btScalar margin)
 {
  m_min[0] = (V1[0]>(V2[0]>V3[0]?V3[0]:V2[0])?(V2[0]>V3[0]?V3[0]:V2[0]):V1[0]);
  m_min[1] = (V1[1]>(V2[1]>V3[1]?V3[1]:V2[1])?(V2[1]>V3[1]?V3[1]:V2[1]):V1[1]);
  m_min[2] = (V1[2]>(V2[2]>V3[2]?V3[2]:V2[2])?(V2[2]>V3[2]?V3[2]:V2[2]):V1[2]);

  m_max[0] = (V1[0]<(V2[0]<V3[0]?V3[0]:V2[0])?(V2[0]<V3[0]?V3[0]:V2[0]):V1[0]);
  m_max[1] = (V1[1]<(V2[1]<V3[1]?V3[1]:V2[1])?(V2[1]<V3[1]?V3[1]:V2[1]):V1[1]);
  m_max[2] = (V1[2]<(V2[2]<V3[2]?V3[2]:V2[2])?(V2[2]<V3[2]?V3[2]:V2[2]):V1[2]);

  m_min[0] -= margin;
  m_min[1] -= margin;
  m_min[2] -= margin;
  m_max[0] += margin;
  m_max[1] += margin;
  m_max[2] += margin;
 }


 inline void appy_transform(const btTransform & trans)
 {
  btVector3 center = (m_max+m_min)*0.5f;
  btVector3 extends = m_max - center;

  center = trans(center);

  btVector3 textends(extends.dot(trans.getBasis().getRow(0).absolute()),
      extends.dot(trans.getBasis().getRow(1).absolute()),
     extends.dot(trans.getBasis().getRow(2).absolute()));

  m_min = center - textends;
  m_max = center + textends;
 }


 inline void merge(const GIM_AABB & box)
 {
  m_min[0] = (m_min[0]>box.m_min[0]?box.m_min[0]:m_min[0]);
  m_min[1] = (m_min[1]>box.m_min[1]?box.m_min[1]:m_min[1]);
  m_min[2] = (m_min[2]>box.m_min[2]?box.m_min[2]:m_min[2]);

  m_max[0] = (m_max[0]<box.m_max[0]?box.m_max[0]:m_max[0]);
  m_max[1] = (m_max[1]<box.m_max[1]?box.m_max[1]:m_max[1]);
  m_max[2] = (m_max[2]<box.m_max[2]?box.m_max[2]:m_max[2]);
 }


 template<typename CLASS_POINT>
 inline void merge_point(const CLASS_POINT & point)
 {
  m_min[0] = (m_min[0]>point[0]?point[0]:m_min[0]);
  m_min[1] = (m_min[1]>point[1]?point[1]:m_min[1]);
  m_min[2] = (m_min[2]>point[2]?point[2]:m_min[2]);

  m_max[0] = (m_max[0]<point[0]?point[0]:m_max[0]);
  m_max[1] = (m_max[1]<point[1]?point[1]:m_max[1]);
  m_max[2] = (m_max[2]<point[2]?point[2]:m_max[2]);
 }


 inline void get_center_extend(btVector3 & center,btVector3 & extend) const
 {
  center = (m_max+m_min)*0.5f;
  extend = m_max - center;
 }


 inline void find_intersection(const GIM_AABB & other, GIM_AABB & intersection) const
 {
  intersection.m_min[0] = (other.m_min[0]<m_min[0]?m_min[0]:other.m_min[0]);
  intersection.m_min[1] = (other.m_min[1]<m_min[1]?m_min[1]:other.m_min[1]);
  intersection.m_min[2] = (other.m_min[2]<m_min[2]?m_min[2]:other.m_min[2]);

  intersection.m_max[0] = (other.m_max[0]>m_max[0]?m_max[0]:other.m_max[0]);
  intersection.m_max[1] = (other.m_max[1]>m_max[1]?m_max[1]:other.m_max[1]);
  intersection.m_max[2] = (other.m_max[2]>m_max[2]?m_max[2]:other.m_max[2]);
 }


 inline bool has_collision(const GIM_AABB & other) const
 {
  if(m_min[0] > other.m_max[0] ||
     m_max[0] < other.m_min[0] ||
     m_min[1] > other.m_max[1] ||
     m_max[1] < other.m_min[1] ||
     m_min[2] > other.m_max[2] ||
     m_max[2] < other.m_min[2])
  {
   return false;
  }
  return true;
 }






 inline bool collide_ray(const btVector3 & vorigin,const btVector3 & vdir)
 {
  btVector3 extents,center;
  this->get_center_extend(center,extents);;

  btScalar Dx = vorigin[0] - center[0];
  if(btFabs(Dx) > (extents[0]) && Dx*vdir[0]>=0.0f) return false;
  btScalar Dy = vorigin[1] - center[1];
  if(btFabs(Dy) > (extents[1]) && Dy*vdir[1]>=0.0f) return false;
  btScalar Dz = vorigin[2] - center[2];
  if(btFabs(Dz) > (extents[2]) && Dz*vdir[2]>=0.0f) return false;


  btScalar f = vdir[1] * Dz - vdir[2] * Dy;
  if(btFabs(f) > extents[1]*btFabs(vdir[2]) + extents[2]*btFabs(vdir[1])) return false;
  f = vdir[2] * Dx - vdir[0] * Dz;
  if(btFabs(f) > extents[0]*btFabs(vdir[2]) + extents[2]*btFabs(vdir[0]))return false;
  f = vdir[0] * Dy - vdir[1] * Dx;
  if(btFabs(f) > extents[0]*btFabs(vdir[1]) + extents[1]*btFabs(vdir[0]))return false;
  return true;
 }


 inline void projection_interval(const btVector3 & direction, btScalar &vmin, btScalar &vmax) const
 {
  btVector3 center = (m_max+m_min)*0.5f;
  btVector3 extend = m_max-center;

  btScalar _fOrigin = direction.dot(center);
  btScalar _fMaximumExtent = extend.dot(direction.absolute());
  vmin = _fOrigin - _fMaximumExtent;
  vmax = _fOrigin + _fMaximumExtent;
 }

 inline ePLANE_INTERSECTION_TYPE plane_classify(const btVector4 &plane) const
 {
  btScalar _fmin,_fmax;
  this->projection_interval(plane,_fmin,_fmax);

  if(plane[3] > _fmax + 0.000001f)
  {
   return G_BACK_PLANE;
  }

  if(plane[3]+0.000001f >=_fmin)
  {
   return G_COLLIDE_PLANE;
  }
  return G_FRONT_PLANE;
 }

 inline bool overlapping_trans_conservative(const GIM_AABB & box, btTransform & trans1_to_0)
 {
  GIM_AABB tbox = box;
  tbox.appy_transform(trans1_to_0);
  return has_collision(tbox);
 }


 inline bool overlapping_trans_cache(
  const GIM_AABB & box,const GIM_BOX_BOX_TRANSFORM_CACHE & transcache, bool fulltest)
 {


  btVector3 ea,eb;
  btVector3 ca,cb;
  get_center_extend(ca,ea);
  box.get_center_extend(cb,eb);


  btVector3 T;
  btScalar t,t2;
  int i;


  for(i=0;i<3;i++)
  {
   T[i] = transcache.m_R1to0[i].dot(cb) + transcache.m_T1to0[i] - ca[i];
   t = transcache.m_AR[i].dot(eb) + ea[i];
   if(btFabs(T[i]) > (t)) return false;
  }

  for(i=0;i<3;i++)
  {
   t = (T[0]*transcache.m_R1to0[0][i] + T[1]*transcache.m_R1to0[1][i] + T[2]*transcache.m_R1to0[2][i]);
   t2 = (ea[0]*transcache.m_AR[0][i] + ea[1]*transcache.m_AR[1][i] + ea[2]*transcache.m_AR[2][i]) + eb[i];
   if(btFabs(t) > (t2)) return false;
  }

  if(fulltest)
  {
   int j,m,n,o,p,q,r;
   for(i=0;i<3;i++)
   {
    m = (i+1)%3;
    n = (i+2)%3;
    o = i==0?1:0;
    p = i==2?1:2;
    for(j=0;j<3;j++)
    {
     q = j==2?1:2;
     r = j==0?1:0;
     t = T[n]*transcache.m_R1to0[m][j] - T[m]*transcache.m_R1to0[n][j];
     t2 = ea[o]*transcache.m_AR[p][j] + ea[p]*transcache.m_AR[o][j] +
      eb[r]*transcache.m_AR[i][q] + eb[q]*transcache.m_AR[i][r];
     if(btFabs(t) > (t2)) return false;
    }
   }
  }
  return true;
 }


 inline bool collide_plane(
  const btVector4 & plane)
 {
  ePLANE_INTERSECTION_TYPE classify = plane_classify(plane);
  return (classify == G_COLLIDE_PLANE);
 }


 inline bool collide_triangle_exact(
  const btVector3 & p1,
  const btVector3 & p2,
  const btVector3 & p3,
  const btVector4 & triangle_plane)
 {
  if(!collide_plane(triangle_plane)) return false;

  btVector3 center,extends;
  this->get_center_extend(center,extends);

  const btVector3 v1(p1 - center);
  const btVector3 v2(p2 - center);
  const btVector3 v3(p3 - center);


  btVector3 diff(v2 - v1);
  btVector3 abs_diff = diff.absolute();

  { { const btScalar dir0 = -diff[2]; const btScalar dir1 = diff[1]; btScalar pmin = v1[1]*dir0 + v1[2]*dir1; btScalar pmax = v3[1]*dir0 + v3[2]*dir1; if(pmin>pmax) { { pmin = pmin+pmax; pmax = pmin-pmax; pmin = pmin-pmax; }; } const btScalar abs_dir0 = abs_diff[2]; const btScalar abs_dir1 = abs_diff[1]; const btScalar rad = extends[1] * abs_dir0 + extends[2] * abs_dir1; if(pmin>rad || -rad>pmax) return false;};};

  { { const btScalar dir0 = -diff[0]; const btScalar dir1 = diff[2]; btScalar pmin = v1[2]*dir0 + v1[0]*dir1; btScalar pmax = v3[2]*dir0 + v3[0]*dir1; if(pmin>pmax) { { pmin = pmin+pmax; pmax = pmin-pmax; pmin = pmin-pmax; }; } const btScalar abs_dir0 = abs_diff[0]; const btScalar abs_dir1 = abs_diff[2]; const btScalar rad = extends[2] * abs_dir0 + extends[0] * abs_dir1; if(pmin>rad || -rad>pmax) return false;};};

  { { const btScalar dir0 = -diff[1]; const btScalar dir1 = diff[0]; btScalar pmin = v1[0]*dir0 + v1[1]*dir1; btScalar pmax = v3[0]*dir0 + v3[1]*dir1; if(pmin>pmax) { { pmin = pmin+pmax; pmax = pmin-pmax; pmin = pmin-pmax; }; } const btScalar abs_dir0 = abs_diff[1]; const btScalar abs_dir1 = abs_diff[0]; const btScalar rad = extends[0] * abs_dir0 + extends[1] * abs_dir1; if(pmin>rad || -rad>pmax) return false;};};


  diff = v3 - v2;
  abs_diff = diff.absolute();

