class Object
{
 public :



  Object () {}



  virtual ~Object () {}



  virtual int operator == (Object &) = 0;
  int operator != (Object &o) { return !(*this == o); }



  virtual char *Type () { return "Object"; }
};

typedef Object *Objp;
