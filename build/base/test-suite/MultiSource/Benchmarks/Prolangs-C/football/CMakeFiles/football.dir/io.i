int find_nth_place_team(ORDERING standings,int conf,int div,int place)
{
  int team_code;
  int next_found_is;

  next_found_is = 1;

  for (team_code=1; team_code <= 28; team_code ++)
    if ((divisions[standings[team_code]][0] == conf ||
  conf == 999) &&
 (divisions[standings[team_code]][1] == div ||
  div == 999))
      if (next_found_is == place) return standings[team_code];
      else next_found_is ++;
  return 0;
}
