void enter_week(FILE *output,FILE *input,int week)
{
  int game;
  char *resp;
  int ABORT;
  TEAM team_code;
  int FOUND_GAME;
  int FIRST,SECOND;

  clear_screen(output);
  (void) fprintf(output, "Enter blank line to leave a score unchanged, \n");
  (void) fprintf(output, "QUIT to return to menu, or new value for the score.\n");
  (void) fprintf(output,"\nWeek %d\n\n",week);

  ABORT = 0;
  while (!ABORT) {
    team_code = 0;
    while (((team_code == 0) || (team_code == 28 +1)) && !ABORT) {
      (void) fprintf(output,"Enter either team: ");
      resp = get_responce(input);
      if (end_of_line(responce) || matches(responce,"quit",1))
 ABORT = 1;
      else
 team_code = find_name(output,resp);
    }

    FOUND_GAME=0;
    for (game=1;(!ABORT && (game<=28/2) && !FOUND_GAME);game++)
  {
    if ((sched[week][game][2] == team_code) &&
        (sched[week][game][1] != 28 +1)) {
      FIRST = 2;
      SECOND = 1;
      FOUND_GAME=1;
    }
    if ((sched[week][game][1] == team_code) &&
        (sched[week][game][2] != 28 +1)) {
      FIRST = 1;
      SECOND = 2;
      FOUND_GAME=1;
    }
  }
    if (!ABORT)
      if (!FOUND_GAME)
 (void) fprintf(output,"No game found for %s in week %d\n",
         team[team_code][1], week);
      else {
 game --;
 (void) fprintf(output,"%-16s",team[sched[week][game][FIRST]][1]);
 if (scores[week][game][FIRST] < 0)
   (void) fprintf(output,"         ? ");
 else (void) fprintf(output,"  %2d     ? ",scores[week][game][FIRST]);
 resp = get_responce(input);
 if (matches(resp,"quit",1)) ABORT = 1;
 if ( *resp != '\0' && !ABORT) {
   (void) sscanf(resp,"%d",&(scores[week][game][FIRST]));
   current_with_disk = 0;
 }

 if (!ABORT) {
   (void) fprintf(output,"%-16s",team[sched[week][game][SECOND]][1]);
   if (scores[week][game][SECOND] < 0)
     (void) fprintf(output,"         ? ");
   else (void) fprintf(output,"  %2d     ? ",scores[week][game][SECOND]);
   resp = get_responce(input);
   if (matches(resp,"quit",1)) ABORT = 1;
   if ( *resp != '\0' && !ABORT) {
     (void) sscanf(resp,"%d",&(scores[week][game][SECOND]));
     current_with_disk = 0;
   }
 }
 (void) fprintf(output,"\n");
      }
  }
}


