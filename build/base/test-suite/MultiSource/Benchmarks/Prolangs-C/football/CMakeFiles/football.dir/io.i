    (void) fprintf(output, "%- 14s%1s %2d %2d %2d %s.%03d %3d %3d", team[standings[t+14]][1], (a_champ(standings[t+14]) ? "*" : (a_wild_card(standings[t+14]) ? "+" : " ")), team_info[standings[t+14]].wins,team_info[standings[t+14]].loses, team_info[standings[t+14]].ties, (((team_info[standings[t+14]].wins+team_info[standings[t+14]].loses+team_info[standings[t+14]].ties)==0 ? 0.0 : ((team_info[standings[t+14]].wins + .5*team_info[standings[t+14]].ties)/(team_info[standings[t+14]].wins+team_info[standings[t+14]].loses+team_info[standings[t+14]].ties))) >= 1.0 ? "1" : " "), (((team_info[standings[t+14]].wins+team_info[standings[t+14]].loses+team_info[standings[t+14]].ties)==0 ? 0.0 : ((team_info[standings[t+14]].wins + .5*team_info[standings[t+14]].ties)/(team_info[standings[t+14]].wins+team_info[standings[t+14]].loses+team_info[standings[t+14]].ties))) >= 1.0 ? 0 : (int) (((team_info[standings[t+14]].wins+team_info[standings[t+14]].loses+team_info[standings[t+14]].ties)==0 ? 0.0 : ((team_info[standings[t+14]].wins + .5*team_info[standings[t+14]].ties)/(team_info[standings[t+14]].wins+team_info[standings[t+14]].loses+team_info[standings[t+14]].ties)))*1000+.5)), team_info[standings[t+14]].points_for, team_info[standings[t+14]].points_against);
    (void) fprintf(output,"\n");
  }
  (void) fprintf(output,"\n");
