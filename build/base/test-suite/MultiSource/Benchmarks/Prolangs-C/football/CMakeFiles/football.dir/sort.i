  {int i,j; int flag; int temp; flag = 1; for (i=1; i<=28 && flag; i ++) {flag = 0; for (j=28; j>i; j --) if (net_lt(team_info,net_ranks[j],net_ranks[j-1])) { temp = net_ranks[j-1]; net_ranks[j-1]=net_ranks[j]; net_ranks[j]=temp; flag = 1;}}};
  {int i,j; int flag; int temp; flag = 1; for (i=1; i<=28 && flag; i ++) {flag = 0; for (j=28; j>i; j --) if (net_nfl_lt(team_info,net_ranks_nfl[j],net_ranks_nfl[j-1])) { temp = net_ranks_nfl[j-1]; net_ranks_nfl[j-1]=net_ranks_nfl[j]; net_ranks_nfl[j]=temp; flag = 1;}}};
