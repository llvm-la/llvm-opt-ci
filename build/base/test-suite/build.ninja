build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/build/base/test-suite && /usr/bin/cmake --regenerate-during-build -S/home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/repos/llvm-test-suite -B/home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/build/base/test-suite
