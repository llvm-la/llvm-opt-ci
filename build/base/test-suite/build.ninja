build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/build/base/test-suite && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
