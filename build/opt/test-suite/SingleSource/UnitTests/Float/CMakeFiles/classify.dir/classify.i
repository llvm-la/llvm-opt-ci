# 157 "/home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/repos/llvm-test-suite/SingleSource/UnitTests/Float/classify-ldouble.h" 2

void test_isfpclass_ldouble() {
  for (unsigned i = 0; i < (sizeof(LongDoubleZeroValues) / sizeof(LongDoubleZeroValues[0])); ++i) {
    long double X = *(long double *)(LongDoubleZeroValues + i);
    if (__builtin_signbit(X))
      test_fcNegZero_ldouble(X);
    else
      test_fcPosZero_ldouble(X);
  }

  for (unsigned i = 0; i < (sizeof(LongDoubleDenormValues) / sizeof(LongDoubleDenormValues[0])); ++i) {
    long double X = *(long double *)(LongDoubleDenormValues + i);
    if (X < 0)
      test_fcNegSubnormal_ldouble(X);
    else
      test_fcPosSubnormal_ldouble(X);
  }

  for (unsigned i = 0; i < (sizeof(LongDoubleNormalValues) / sizeof(LongDoubleNormalValues[0])); ++i) {
    long double X = *(long double *)(LongDoubleNormalValues + i);
    if (X < 0)
      test_fcNegNormal_ldouble(X);
    else
      test_fcPosNormal_ldouble(X);
  }

  for (unsigned i = 0; i < (sizeof(LongDoubleInfValues) / sizeof(LongDoubleInfValues[0])); ++i) {
    long double X = *(long double *)(LongDoubleInfValues + i);
    if (X > 0)
      test_fcPosInf_ldouble(X);
    else
      test_fcNegInf_ldouble(X);
  }

  for (unsigned i = 0; i < (sizeof(LongDoubleQNaNValues) / sizeof(LongDoubleQNaNValues[0])); ++i) {
    long double X = *(long double *)(LongDoubleQNaNValues + i);
    test_fcQNan_ldouble(X);
  }
  for (unsigned i = 0; i < (sizeof(LongDoubleSNaNValues) / sizeof(LongDoubleSNaNValues[0])); ++i) {
    long double X = *(long double *)(LongDoubleSNaNValues + i);
    test_fcSNan_ldouble(X);
  }
}
