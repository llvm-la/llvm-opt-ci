"                 return dsp_to_double(result); \n"
"         } \n"
"         else if (i < 4) \n"
"                 return multiplier ? dau_get_amult(i) : dsp32.a[i]; \n"
"         else \n"
"                 return dau_read_pi_special(i); \n"
" } \n"
"  \n"
"  \n"
"  unsigned long dau_read_pi_4bytes(int pi) \n"
" { \n"
"         int p = (pi >> 3) & 15; \n"
"         int i = (pi >> 0) & 7; \n"
"  \n"
"         lastp = p; \n"
"         if (p) \n"
"         { \n"
"                 unsigned long result = RLONG(dsp32.r[p]); \n"
