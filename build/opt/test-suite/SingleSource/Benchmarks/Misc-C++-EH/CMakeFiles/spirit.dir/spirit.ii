" { \n"
"         remember_last_dau(aidx); \n"
"  \n"
" { \n"
"         double absres = (res < 0) ? -res : res; \n"
"         dsp32.VUflags = 0; \n"
"         if (absres < 5.87747e-39) \n"
"         { \n"
"                 if (absres != 0) \n"
"                         dsp32.VUflags = UFLAGBIT; \n"
"                 res = 0.0; \n"
"         } \n"
