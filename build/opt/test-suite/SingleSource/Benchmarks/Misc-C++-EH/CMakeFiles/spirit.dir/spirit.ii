"  unsigned char cau_read_pi_1byte(int pi) \n"
" { \n"
"         int p = (pi >> 5) & 0x1f; \n"
"         int i = (pi >> 0) & 0x1f; \n"
"         if (p) \n"
"         { \n"
"                 unsigned long result = RBYTE(dsp32.r[p]); \n"
"                 dsp32.r[p] = ((dsp32.r[p] + dsp32.r[i]) & 0xffffff); \n"
"                 return result; \n"
"         } \n"
"         else \n"
"                 return cau_read_pi_special(i); \n"
" } \n"
"  \n"
