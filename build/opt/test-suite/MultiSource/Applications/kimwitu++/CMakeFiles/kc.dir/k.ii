    const char *name;
    size_t no_sons;
    bool atomicity;
    enum_phyla phylum;
    enum_phyla_list subphylum;
    int no_attrs;
    enum_phyla_list attribute;
    size_t size;
} KC_OPERATOR_INFO;

typedef enum_phyla_list KC_UNIQ_INFO;

