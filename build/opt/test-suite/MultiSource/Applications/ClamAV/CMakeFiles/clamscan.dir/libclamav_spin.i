        break;
      case 0x2a:
        aelle-=cielle;
 len++;
        break;
      case 0x04:
        aelle+=curremu[len];
 len++;
        break;
      case 0x2c:
        aelle-=curremu[len];
 len++;
        break;
      case 0x32:
        aelle^=cielle;
 len++;
        break;
      case 0x34:
        aelle^=curremu[len];
 len++;
        break;

