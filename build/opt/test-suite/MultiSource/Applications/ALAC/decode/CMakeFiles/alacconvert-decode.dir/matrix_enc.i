void mix16( int16_t * in, uint32_t stride, int32_t * u, int32_t * v, int32_t numSamples, int32_t mixbits, int32_t mixres )
{
 int16_t * ip = in;
 int32_t j;

 if ( mixres != 0 )
 {
  int32_t mod = 1 << mixbits;
  int32_t m2;


  m2 = mod - mixres;
  for ( j = 0; j < numSamples; j++ )
  {
   int32_t l, r;

   l = (int32_t) ip[0];
   r = (int32_t) ip[1];
   ip += stride;
   u[j] = (mixres * l + m2 * r) >> mixbits;
   v[j] = l - r;
  }
 }
 else
 {

  for ( j = 0; j < numSamples; j++ )
  {
   u[j] = (int32_t) ip[0];
   v[j] = (int32_t) ip[1];
   ip += stride;
  }
 }
}




