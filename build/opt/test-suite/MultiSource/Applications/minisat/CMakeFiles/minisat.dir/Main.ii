static inline void check(bool expr) { (static_cast<void> (0)); }


inline void Solver::printLit(Lit l)
{
    ( fflush(stdout), fprintf(stderr, "%s%d:%c", sign(l) ? "-" : "", var(l)+1, value(l) == l_True ? '1' : (value(l) == l_False ? '0' : 'X')), fflush(stderr) );
}


template<class C>
inline void Solver::printClause(const C& c)
{
    for (int i = 0; i < c.size(); i++){
        printLit(c[i]);
        fprintf(stderr, " ");
    }
}
