class StreamBuffer {
    FILE *in;
    char buf[1048576];
    int pos;
    int size;

    void assureLookahead() {
        if (pos >= size) {
            pos = 0;
            size = read(fileno(in), buf, sizeof(buf)); } }

public:
    StreamBuffer(FILE *i) : in(i), pos(0), size(0) {
        assureLookahead(); }

    int operator * () { return (pos >= size) ? (-1) : buf[pos]; }
    void operator ++ () { pos++; assureLookahead(); }
};



template<class B>
static void skipWhitespace(B& in) {
    while ((*in >= 9 && *in <= 13) || *in == 32)
        ++in; }

template<class B>
static void skipLine(B& in) {
    for (;;){
        if (*in == (-1) || *in == '\0') return;
        if (*in == '\n') { ++in; return; }
        ++in; } }

template<class B>
static int parseInt(B& in) {
    int val = 0;
    bool neg = false;
    skipWhitespace(in);
    if (*in == '-') neg = true, ++in;
    else if (*in == '+') ++in;
    if (*in < '0' || *in > '9') ( fflush(stdout), fprintf(stderr, "PARSE ERROR! Unexpected char: %c\n", *in), fflush(stderr) ), exit(3);
    while (*in >= '0' && *in <= '9')
        val = val*10 + (*in - '0'),
        ++in;
    return neg ? -val : val; }

template<class B>
static void readClause(B& in, Solver& S, vec<Lit>& lits) {
    int parsed_lit, var;
    lits.clear();
    for (;;){
        parsed_lit = parseInt(in);
        if (parsed_lit == 0) break;
        var = abs(parsed_lit)-1;
        while (var >= S.nVars()) S.newVar();
        lits.push( (parsed_lit > 0) ? Lit(var) : ~Lit(var) );
    }
}

template<class B>
static bool match(B& in, char* str) {
    for (; *str != 0; ++str, ++in)
        if (*str != *in)
            return false;
    return true;
}


template<class B>
static void parse_DIMACS_main(B& in, Solver& S) {
    vec<Lit> lits;
    for (;;){
        skipWhitespace(in);
        if (*in == (-1))
            break;
        else if (*in == 'p'){
            if (match(in, "p cnf")){
                int vars = parseInt(in);
                int clauses = parseInt(in);
                ( fflush(stdout), fprintf(stderr, "|  Number of variables:  %-12d                                         |\n", vars), fflush(stderr) );
                ( fflush(stdout), fprintf(stderr, "|  Number of clauses:    %-12d                                         |\n", clauses), fflush(stderr) );
            }else{
                ( fflush(stdout), fprintf(stderr, "PARSE ERROR! Unexpected char: %c\n", *in), fflush(stderr) ), exit(3);
            }
        } else if (*in == 'c' || *in == 'p')
            skipLine(in);
        else
            readClause(in, S, lits),
            S.addClause(lits);
    }
}



static void parse_DIMACS(FILE *input_stream, Solver& S) {


    StreamBuffer *in = new StreamBuffer(input_stream);
    parse_DIMACS_main(*in, S);
    delete in;
}





void printStats(Solver& solver)
{
    double cpu_time = cpuTime();
    uint64_t mem_used = memUsed();
    ( fflush(stdout), fprintf(stderr, "restarts              : %lld\n", solver.starts), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "conflicts             : %-12lld\n", solver.conflicts), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "decisions             : %-12lld   (%4.2f %% random)\n", solver.decisions, (float)solver.rnd_decisions*100 / (float)solver.decisions), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "propagations          : %-12lld\n", solver.propagations), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "conflict literals     : %-12lld   (%4.2f %% deleted)\n", solver.tot_literals, (solver.max_literals - solver.tot_literals)*100 / (double)solver.max_literals), fflush(stderr) );
}

Solver* solver;




void printUsage(char** argv)
{
    ( fflush(stdout), fprintf(stderr, "USAGE: %s [options] <input-file> <result-output-file>\n\n  where input may be either in plain or gzipped DIMACS.\n\n", argv[0]), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "OPTIONS:\n\n"), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "  -polarity-mode = {true,false,rnd}\n"), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "  -decay         = <num> [ 0 - 1 ]\n"), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "  -rnd-freq      = <num> [ 0 - 1 ]\n"), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "  -verbosity     = {0,1,2}\n"), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "\n"), fflush(stderr) );
}


const char* hasPrefix(const char* str, const char* prefix)
{
    int len = strlen(prefix);
    if (strncmp(str, prefix, len) == 0)
        return strdup(str + len);
    else
        return __null;
}


int main(int argc, char** argv)
{
    Solver S;
    S.verbosity = 1;


    int i, j;
    const char* value;
    for (i = j = 0; i < argc; i++){
        if ((value = hasPrefix(argv[i], "-polarity-mode="))){
            if (strcmp(value, "true") == 0)
                S.polarity_mode = Solver::polarity_true;
            else if (strcmp(value, "false") == 0)
                S.polarity_mode = Solver::polarity_false;
            else if (strcmp(value, "rnd") == 0)
                S.polarity_mode = Solver::polarity_rnd;
            else{
                ( fflush(stdout), fprintf(stderr, "ERROR! unknown polarity-mode %s\n", value), fflush(stderr) );
                exit(0); }

        }else if ((value = hasPrefix(argv[i], "-rnd-freq="))){
            double rnd;
            if (sscanf(value, "%lf", &rnd) <= 0 || rnd < 0 || rnd > 1){
                ( fflush(stdout), fprintf(stderr, "ERROR! illegal rnd-freq constant %s\n", value), fflush(stderr) );
                exit(0); }
            S.random_var_freq = rnd;

        }else if ((value = hasPrefix(argv[i], "-decay="))){
            double decay;
            if (sscanf(value, "%lf", &decay) <= 0 || decay <= 0 || decay > 1){
                ( fflush(stdout), fprintf(stderr, "ERROR! illegal decay constant %s\n", value), fflush(stderr) );
                exit(0); }
            S.var_decay = 1 / decay;

        }else if ((value = hasPrefix(argv[i], "-verbosity="))){
            char *end;
            int verbosity = (int)strtol(value, &end, 10);
            if (end == value || *end != 0){
                ( fflush(stdout), fprintf(stderr, "ERROR! illegal verbosity level %s\n", value), fflush(stderr) );
                exit(0); }
            S.verbosity = verbosity;

        }else if (strcmp(argv[i], "-h") == 0 || strcmp(argv[i], "-help") == 0 || strcmp(argv[i], "--help") == 0){
            printUsage(argv);
            exit(0);

        }else if (strncmp(argv[i], "-", 1) == 0){
            ( fflush(stdout), fprintf(stderr, "ERROR! unknown flag %s\n", argv[i]), fflush(stderr) );
            exit(0);

        }else
            argv[j++] = argv[i];
    }
    argc = j;


    ( fflush(stdout), fprintf(stderr, "This is MiniSat 2.0 beta\n"), fflush(stderr) );




    double cpu_time = cpuTime();

    solver = &S;

    if (argc == 1)
        ( fflush(stdout), fprintf(stderr, "Reading from standard input... Use '-h' or '--help' for help.\n"), fflush(stderr) );

    FILE *in = (argc == 1) ? stdin : fopen(argv[1], "rb");
    if (in == __null)
        ( fflush(stdout), fprintf(stderr, "ERROR! Could not open file: %s\n", argc == 1 ? "<stdin>" : argv[1]), fflush(stderr) ), exit(1);

    ( fflush(stdout), fprintf(stderr, "============================[ Problem Statistics ]=============================\n"), fflush(stderr) );
    ( fflush(stdout), fprintf(stderr, "|                                                                             |\n"), fflush(stderr) );

    parse_DIMACS(in, S);
    fclose(in);
    FILE* res = (argc >= 3) ? fopen(argv[2], "wb") : __null;

    if (!S.simplify()){
        ( fflush(stdout), fprintf(stderr, "Solved by unit propagation\n"), fflush(stderr) );
        if (res != __null) fprintf(res, "UNSAT\n"), fclose(res);
        printf("UNSATISFIABLE\n");
        exit(20);
    }

    bool ret = S.solve();
    printStats(S);
    ( fflush(stdout), fprintf(stderr, "\n"), fflush(stderr) );
    printf(ret ? "SATISFIABLE\n" : "UNSATISFIABLE\n");
    if (res != __null){
        if (ret){
            fprintf(res, "SAT\n");
            for (int i = 0; i < S.nVars(); i++)
                if (S.model[i] != l_Undef)
                    fprintf(res, "%s%s%d", (i==0)?"":" ", (S.model[i]==l_True)?"":"-", i+1);
            fprintf(res, " 0\n");
        }else
            fprintf(res, "UNSAT\n");
        fclose(res);
    }


    exit(ret ? 10 : 20);

}
