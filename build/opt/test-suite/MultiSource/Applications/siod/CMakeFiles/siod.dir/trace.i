LISP ltrace_fcn_name(LISP body)
{LISP tmp;
 if ((((body) == ((struct obj *) 0)) ? 0 : ((*(body)).type)) != (1)) return(((struct obj *) 0));
 if ((((*body).storage_as.cons.car)) != (sym_begin)) return(((struct obj *) 0));
 tmp = ((*body).storage_as.cons.cdr);
 if ((((tmp) == ((struct obj *) 0)) ? 0 : ((*(tmp)).type)) != (1)) return(((struct obj *) 0));
 tmp = ((*tmp).storage_as.cons.car);
 if ((((tmp) == ((struct obj *) 0)) ? 0 : ((*(tmp)).type)) != (1)) return(((struct obj *) 0));
 if ((((*tmp).storage_as.cons.car)) != (sym_quote)) return(((struct obj *) 0));
 tmp = ((*tmp).storage_as.cons.cdr);
 if ((((tmp) == ((struct obj *) 0)) ? 0 : ((*(tmp)).type)) != (1)) return(((struct obj *) 0));
 return(((*tmp).storage_as.cons.car));}

LISP ltrace_1(LISP fcn_name,LISP env)
{LISP fcn,code;
 fcn = leval(fcn_name,env);
 if ((((fcn) == ((struct obj *) 0)) ? 0 : ((*(fcn)).type)) == 11)
   {code = fcn->storage_as.closure.code;
    if ((ltrace_fcn_name(cdr(code))) == (((struct obj *) 0)))
      setcdr(code,cons(sym_begin,
         cons(cons(sym_quote,cons(fcn_name,((struct obj *) 0))),
       cons(cdr(code),((struct obj *) 0)))));
    fcn->type = (short) tc_closure_traced;}
 else if ((((fcn) == ((struct obj *) 0)) ? 0 : ((*(fcn)).type)) == tc_closure_traced)
   ;
 else
   err("not a closure, cannot trace",fcn);
 return(((struct obj *) 0));}

LISP ltrace(LISP fcn_names,LISP env)
{LISP l;
 for(l=fcn_names;((l) != (((struct obj *) 0)));l=cdr(l))
   ltrace_1(car(l),env);
 return(((struct obj *) 0));}

LISP luntrace_1(LISP fcn)
{if ((((fcn) == ((struct obj *) 0)) ? 0 : ((*(fcn)).type)) == 11)
   ;
 else if ((((fcn) == ((struct obj *) 0)) ? 0 : ((*(fcn)).type)) == tc_closure_traced)
   fcn->type = 11;
 else
   err("not a closure, cannot untrace",fcn);
 return(((struct obj *) 0));}

LISP luntrace(LISP fcns)
{LISP l;
 for(l=fcns;((l) != (((struct obj *) 0)));l=cdr(l))
   luntrace_1(car(l));
 return(((struct obj *) 0));}

static void ct_gc_scan(LISP ptr)
{((*ptr).storage_as.cons.car) = gc_relocate(((*ptr).storage_as.cons.car));
 ((*ptr).storage_as.cons.cdr) = gc_relocate(((*ptr).storage_as.cons.cdr));}

static LISP ct_gc_mark(LISP ptr)
{gc_mark(ptr->storage_as.closure.code);
 return(ptr->storage_as.closure.env);}

void ct_prin1(LISP ptr,struct gen_printio *f)
{gput_st(f,"#<CLOSURE(TRACED) ");
 lprin1g(car(ptr->storage_as.closure.code),f);
 gput_st(f," ");
 lprin1g(cdr(ptr->storage_as.closure.code),f);
 gput_st(f,">");}

LISP ct_eval(LISP ct,LISP *px,LISP *penv)
{LISP fcn_name,args,env,result,l;
 fcn_name = ltrace_fcn_name(cdr(ct->storage_as.closure.code));
 args = leval_args(((**px).storage_as.cons.cdr),*penv);
 fput_st(stdout,"->");
 lprin1f(fcn_name,stdout);
 for(l=args;((l) != (((struct obj *) 0)));l=cdr(l))
   {fput_st(stdout," ");
    lprin1f(car(l),stdout);}
 fput_st(stdout,"\n");
 env = extend_env(args,
    car(ct->storage_as.closure.code),
    ct->storage_as.closure.env);
 result = leval(cdr(ct->storage_as.closure.code),env);
 fput_st(stdout,"<-");
 lprin1f(fcn_name,stdout);
 fput_st(stdout," ");
 lprin1f(result,stdout);
 fput_st(stdout,"\n");
 *px = result;
 return(((struct obj *) 0));}

void init_trace(void)
{long j;
 tc_closure_traced = allocate_user_tc();
 set_gc_hooks(tc_closure_traced,
       ((void*)0),
       ct_gc_mark,
       ct_gc_scan,
       ((void*)0),
       &j);
 gc_protect_sym(&sym_traced,"*traced*");
 setvar(sym_traced,((struct obj *) 0),((struct obj *) 0));
 gc_protect_sym(&sym_begin,"begin");
 gc_protect_sym(&sym_quote,"quote");
 set_print_hooks(tc_closure_traced,ct_prin1);
 set_eval_hooks(tc_closure_traced,ct_eval);
 init_fsubr("trace",ltrace);
 init_lsubr("untrace",luntrace);
 init_trace_version();}
