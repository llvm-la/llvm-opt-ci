                    if (active_sps->chroma_format_idc == 1)
                      j1 += listX[1+list_offset][l1_refframe]->chroma_vector_adjustment;

                    ii0 = iClip3 (0, img->width_cr_m1, i1/f1_x);
                    jj0 = iClip3 (0, max_y_cr, j1/f1_y);
                    ii1 = iClip3 (0, img->width_cr_m1, ((i1+f2_x)/f1_x));
