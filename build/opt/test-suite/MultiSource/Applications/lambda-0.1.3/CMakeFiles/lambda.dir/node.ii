  if( left() ){
   exp_node* nl = left()->extract_defs(env);
   if( nl )
    set_left( nl, 1);
  }
  if( right() ){
   exp_node* nr = right()->extract_defs(env);
   if( nr )
    set_right( nr, 1);
  }
  alst = match(env);
