app_node(const app_node& from)
{

 if( from.left_v )
  left_v = (exp_node*)from.left_v->clone();
 else left_v = 0;
 if( left_v ) left_v->set_parent(this);
 if( from.right_v )
  right_v =
   (exp_node*)from.right_v->clone();
 else right_v = 0;
 if( right_v) set_parent(this);
 parent_v = from.parent_v;
}

