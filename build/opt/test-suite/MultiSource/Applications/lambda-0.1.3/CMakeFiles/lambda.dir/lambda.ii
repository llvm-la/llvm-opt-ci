 }
# 93 "/home/date/work/actions-runner/_work/llvm-opt-ci/llvm-opt-ci/repos/llvm-test-suite/MultiSource/Applications/lambda-0.1.3/lambda.cc"
 token_stream tokstr;
 tokstr.open();
 lambda_expression_parser parse(&tokstr);

 arglst_node* env = 0;
 while( 1 )
 {
  printf("<< ");
  exp_node* exp = parse.expression(&env);
  if( exp )
  {
   int inp = 0;
   int outp = 0;
   if( node::ARG==exp->op() )
   {
    delete exp;
    break;
   }
   printf("==> ");
   exp->print();
   printf("\n");

   node::reset();
   if( trace_lambda ) inp |= node::DO_TRACE;
   if( print_symbols ) inp |= node::DO_PRINT_SYM;
   if( applicative_order ) inp |= node::DO_APP_ORDER;
   if( reduce_body ) inp |= node::DO_REDUCE_BODY;
   if( step_lambda ) inp |= node::DO_STEP;
   if( brief_print ) inp |= node::DO_PRINT_BRIEF;
   if( reduce_fully ) inp |= node::DO_REDUCE_FULLY;

   int exp_was_var = node::VAR==exp->op();

   if( step_lambda )
   {
    int printed = 0;
    exp_node* rexp = exp->reduce(env,inp,&outp);
    do {
     if( rexp ){
      if(1){
       char* step = "=";
       if( outp & node::BETA_ETA_DONE ){
        if( outp & node::ETA_DONE ){
         step = "H";
        }else{
         step = "B";
        }
       }
       printf("=%1.1s==> ", step );

       if( exp_was_var )
        rexp->print(env,inp&~node::DO_PRINT_SYM);
       else
        rexp->symbolic_print(env,inp);
       printf("\n");
       printed = 1;
      }
      exp_node* nexp;
      if( outp & node::BETA_ETA_DONE) {
       outp &= ~(node::BETA_ETA_DONE|node::ETA_DONE);
       nexp = rexp->reduce(env,inp,&outp);
       if( nexp && rexp!=nexp ){

        delete rexp;
        if( rexp == exp ) exp = 0;
        rexp = nexp;
       }
       if( !(outp & node::BETA_ETA_DONE))
        break;
      }else{
       break;
      }
      printf("*** Continue?[y/n]:");
      int ans = getchar();
      if( '\n'!=ans )
       while ( '\n'!=getchar() );
      if( 'n'==ans || 'N'==ans ) break;
     }
    } while (rexp);
    if( !printed && rexp ){
     printf("=====> ");
     if( exp_was_var )
      rexp->print(env,inp&~node::DO_PRINT_SYM);
     else
      rexp->symbolic_print(env,inp);
     printf("\n");
     printed = 1;

     delete rexp;
     if( rexp == exp ) exp = 0;
     rexp = 0;
    }
   }else if( step_thru ) {
    inp |= node::DO_STEP;
    exp_node* rexp = exp->reduce(env,inp,&outp);
    do {
     if( rexp ){
      exp_node* nexp;
      if( outp & node::BETA_ETA_DONE) {
       outp &= ~node::BETA_ETA_DONE;
       nexp = rexp->reduce(env,inp,&outp);
       if( nexp && rexp!=nexp ){

        delete rexp;
        if( rexp == exp ) exp = 0;
        rexp = nexp;
       }
       if( !(outp & node::BETA_ETA_DONE))
        break;
      }else{
       break;
      }
     }
    } while (rexp);
    if( rexp )
    {
     printf("====>");
     if( exp_was_var )
      rexp->print(env,inp&~node::DO_PRINT_SYM);
     else
      rexp->symbolic_print(env,inp);
     printf("\n");

     delete rexp;
     if( rexp == exp ) exp = 0;
     rexp = 0;
    }
   }else{
    exp_node* rexp = exp->reduce(env,inp,&outp);
    if( rexp )
    {
     printf("====>");
     if( exp_was_var )
      rexp->print(env,inp&~node::DO_PRINT_SYM);
     else
      rexp->symbolic_print(env,inp);
     printf("\n");

     delete rexp;
     if( rexp == exp ) exp = 0;
     rexp = 0;
    }
   }
   if( exp ) delete exp;
   exp = 0;
  }
 }
 tokstr.close();
 return 0;
}
