int find_name(FILE *output,char name[])
{
  int i;
  char full_name[15];

  for (i = 1;i<=28 +1;i++) {
    (void) strcpy(full_name,team[i][1]);
    lower_case(full_name);
    if (! strcmp(team[i][0],name) || !strcmp(full_name,name))
      return i;
  }
 (void) fprintf(output,"No such team %s\n",name);
  return 0;
}

void compute_team_info(void)
{
  int week,game,team,i;

  for (team=1;team<=28; team++)
    for (i=1;i<=28;i++)
      team_plays[team][i] = 0;

  for (team=1;team<=28; team++) {
    team_info[team].wins = team_info[team].loses = team_info[team].ties = 0;
    team_info[team].points_for = team_info[team].points_against = 0;

    team_info_wi_conf[team].wins = 0;
    team_info_wi_conf[team].loses = 0;
    team_info_wi_conf[team].ties = 0;
    team_info_wi_conf[team].points_for = 0;
    team_info_wi_conf[team].points_against = 0;

    team_info_wi_div[team].wins = 0;
    team_info_wi_div[team].loses = 0;
    team_info_wi_div[team].ties = 0;
    team_info_wi_div[team].points_for = 0;
    team_info_wi_div[team].points_against = 0;

    for (i=1;i<=28; i++) {
      h_to_h_stats[team][i].wins = h_to_h_stats[team][i].loses =
 h_to_h_stats[team][i].ties = h_to_h_stats[team][i].points_for =
   h_to_h_stats[team][i].points_against = 0;
    }
  }

  for (week=1;week<=num_games; week++)
    for (game=1;game<=28/2; game++) {
      team_plays[sched[week][game][2]][sched[week][game][1]] = 1;
      team_plays[sched[week][game][1]][sched[week][game][2]] = 1;
      if (scores[week][game][2] >= 0 && scores[week][game][1] >=0) {

 h_to_h_stats[sched[week][game][2]]
   [sched[week][game][1]].points_for += scores[week][game][2];
 h_to_h_stats[sched[week][game][2]]
   [sched[week][game][1]].points_against +=
     scores[week][game][1];
 h_to_h_stats[sched[week][game][1]]
   [sched[week][game][2]].points_for += scores[week][game][1];
 h_to_h_stats[sched[week][game][1]]
   [sched[week][game][2]].points_against +=
     scores[week][game][2];

 if (scores[week][game][2] < scores[week][game][1]) {
   team_info[sched[week][game][2]].loses ++;
   team_info[sched[week][game][1]].wins ++;

   h_to_h_stats[sched[week][game][2]]
     [sched[week][game][1]].loses ++;
   h_to_h_stats[sched[week][game][1]]
     [sched[week][game][2]].wins ++;

   if (divisions[sched[week][game][2]][0] ==
       divisions[sched[week][game][1]][0]) {
     team_info_wi_conf[sched[week][game][2]].loses ++;
     team_info_wi_conf[sched[week][game][1]].wins ++;
     if (divisions[sched[week][game][2]][1] ==
  divisions[sched[week][game][1]][1]) {
       team_info_wi_div[sched[week][game][2]].loses ++;
       team_info_wi_div[sched[week][game][1]].wins ++;
     }
   }
 }
 else
 if (scores[week][game][2] > scores[week][game][1]) {
   team_info[sched[week][game][2]].wins ++;
   team_info[sched[week][game][1]].loses ++;

   h_to_h_stats[sched[week][game][2]]
     [sched[week][game][1]].wins ++;
   h_to_h_stats[sched[week][game][1]]
     [sched[week][game][2]].loses ++;

   if (divisions[sched[week][game][2]][0] ==
       divisions[sched[week][game][1]][0]) {
     team_info_wi_conf[sched[week][game][2]].wins ++;
     team_info_wi_conf[sched[week][game][1]].loses ++;

     if (divisions[sched[week][game][2]][1] ==
  divisions[sched[week][game][1]][1]) {
       team_info_wi_div[sched[week][game][2]].wins ++;
       team_info_wi_div[sched[week][game][1]].loses ++;
     }
   }
 }
 else {
   team_info[sched[week][game][2]].ties ++;
   team_info[sched[week][game][1]].ties ++;

   h_to_h_stats[sched[week][game][2]]
     [sched[week][game][1]].ties ++;
   h_to_h_stats[sched[week][game][1]]
     [sched[week][game][2]].ties ++;

   if (divisions[sched[week][game][2]][0] ==
       divisions[sched[week][game][1]][0]) {
     team_info_wi_conf[sched[week][game][2]].ties ++;
     team_info_wi_conf[sched[week][game][1]].ties ++;

     if (divisions[sched[week][game][2]][1] ==
  divisions[sched[week][game][1]][1]) {
       team_info_wi_div[sched[week][game][2]].ties ++;
       team_info_wi_div[sched[week][game][1]].ties ++;
     }
   }
 }
 team_info[sched[week][game][2]].points_for +=
   scores[week][game][2];
 team_info[sched[week][game][2]].points_against +=
   scores[week][game][1];
 team_info[sched[week][game][1]].points_for +=
   scores[week][game][1];
 team_info[sched[week][game][1]].points_against +=
   scores[week][game][2];

 if (divisions[sched[week][game][2]][0] ==
     divisions[sched[week][game][1]][0]) {
   team_info_wi_conf[sched[week][game][2]].points_for +=
     scores[week][game][2];
   team_info_wi_conf[sched[week][game][2]].points_against +=
     scores[week][game][1];
   team_info_wi_conf[sched[week][game][1]].points_for +=
     scores[week][game][1];
   team_info_wi_conf[sched[week][game][1]].points_against +=
     scores[week][game][2];

   if (divisions[sched[week][game][2]][1] ==
       divisions[sched[week][game][1]][1]) {
     team_info_wi_div[sched[week][game][2]].points_for +=
       scores[week][game][2];
     team_info_wi_div[sched[week][game][2]].points_against +=
       scores[week][game][1];
     team_info_wi_div[sched[week][game][1]].points_for +=
       scores[week][game][1];
     team_info_wi_div[sched[week][game][1]].points_against +=
       scores[week][game][2];
   }
 }
      }
    }
}

void read_sched_into(FILE *STREAM,SCHED_TYPE sched)
{
  int error;
  int num_seen[17 +1];
  int team_code,week_num,temp;
  int AWAY,HOME,TEAM_FIELD,opponent,OPPON_FIELD,find_game;
  char CH;
  char str[10];

  error = 0;
  for (week_num=1;week_num<=num_games;week_num++)
    num_seen[week_num] = 1;

  for (team_code=1;team_code<=28;team_code++) {
    for (week_num=1;week_num<=num_games;week_num++) {
      CH = (char) getc(STREAM);
      while (white_space(CH)) CH = (char) getc(STREAM);
      temp = 0;
      while (!(white_space(CH))) {
 str[temp] = CH;
 temp ++;
 CH = (char) getc(STREAM);
      }
      str[temp] = 0;
      if (str[0] != '@') {
 HOME = team_code;
 TEAM_FIELD = 2;
 OPPON_FIELD = 1;
 AWAY = opponent = find_name(stderr,str);
      }
      else {
 AWAY = team_code;
 TEAM_FIELD = 1;
 OPPON_FIELD = 2;
 HOME = opponent = find_name(stderr,str+1);
      }
      if (opponent < team_code)
      {
 for (find_game = 1; find_game<=num_seen[week_num]-1;find_game++) {
   if (sched[week_num][find_game][TEAM_FIELD] == team_code) {
     if (sched[week_num][find_game][OPPON_FIELD] != opponent) {
       (void) printf("Error in opponent for %s(%d). Expected %s(%d), Found %s(%d). Week #%d\n"
       ,team[team_code][1], team_code,
       team[sched[week_num][find_game][OPPON_FIELD]][1],
       sched[week_num][find_game][OPPON_FIELD],
       team[opponent][1],opponent,week_num);
       error = 1;
     }
     find_game = num_seen[week_num] + 2;
   }
 }
 if (find_game == num_seen[week_num]) {
   (void) printf("%s(%d) not found yet: team: %s(%d); week# %d; opp. str: %s\n",
   team[opponent][1],opponent,team[team_code][1],
   team_code,week_num,str);
   error = 1;
 }
      }
      else if (opponent != 28 + 1) {
 int first_time;

 first_time = 0;
 for (find_game = 1; find_game<=num_seen[week_num]-1;find_game++) {
   if (sched[week_num][find_game][1] == team_code)
          first_time = sched[week_num][find_game][2];
   if (sched[week_num][find_game][2] == team_code)
          first_time = sched[week_num][find_game][1];
 }
 if (first_time) {
   (void) printf("%s(%d) has opponent %s(%d), but wants %s(%d); \n          week# %d\n",
   team[team_code][1],team_code,
   team[first_time][1],first_time,
   team[opponent][1],opponent,week_num);
   error = 1;
 }
 else if ( num_seen[week_num] > 28/2) {
   (void) printf("ERROR: Week %d, to many games seen.\n",week_num);
   error = 1;
 } else {
   sched[week_num][num_seen[week_num]][1] = AWAY;
   sched[week_num][num_seen[week_num]][2] = HOME;
   num_seen[week_num] ++;
 }
      }
    }
  }

if (error) exit(1);
}

void save_scores (FILE *msg_stream,char *file_name)
{
  int game,week;
  FILE *OUTPUT;

  if (!(OUTPUT = fopen(file_name,"w"))) {
    (void) fprintf(msg_stream,"Can not write to %s. Not saved.\n",file_name);
  } else {
    for (week=1;week<=num_games+1; week++) {
      for (game=1;game<=28/2; game++) {
 (void) fprintf(OUTPUT," %d %d",scores[week][game][2],
        scores[week][game][1]);
      }
      (void) fprintf(OUTPUT,"\n");
    }
    (void) fclose(the_scores);
    (void) fprintf(msg_stream,"Saved in %s.\n",file_name);
    current_with_disk = 1;
  }
}

int in_fileP = 0;

int main(int argc, char *argv[])
{
  int argument_error = 0;
  char *year;
  FILE *in_file;

  {int i;
   for (i=1;i<=28;i++) {
     standings[i]=i;
     conf_standings[i]=abs_standings[i]=i;
     defence_ranks[i]=defence_ranks_nfl[i]=i;
     offence_ranks[i]=offence_ranks_nfl[i]=i;
     net_ranks[i]=net_ranks_nfl[i]=i;
   }
 }

  if (argc < 2) argument_error = 1;
  else if (!strcmp(argv[1],"-p")) {
      if (argc > 4) argument_error = 1;
      preseason=1;
      year = argv[2];
      iyear = str_to_int(year);
      num_games = 5;
      if (argc == 4) in_fileP = 3;
  }
  else if (argc <= 3) {
      year = argv[1];
      iyear = str_to_int(year);
      num_games = ( ((iyear >=78) && (iyear <= 89)) ?
     16 : 17);
      if (argc == 3) in_fileP = 2;
  }
  else argument_error = 1;

  if (argument_error) {
    (void) fprintf(stderr,"Usage: stats [-p] <yy> [input-file]\n   <yy> is 2 digit year code.\n");
    exit(1);
  }

  if (iyear <= 87) {
    (void) strcpy(team[11][0],"sl");
    (void) strcpy(team[11][1],"St. Louis");
  }

  (void) strcpy(inp_sched,"data/sched.19");
  (void) strcat(inp_sched,year);

if (preseason)
  (void) strcat(inp_sched,".pre");

  if (! (schedule = fopen(inp_sched,"r"))) {
    (void) fprintf(stderr,"ERROR: Can not open %s.\n",inp_sched);
    exit(1);
  }

  read_sched_into(schedule,sched);
  (void) fclose(schedule);

  if (in_fileP) {
      in_file = fopen(argv[in_fileP],"r");
      if (!in_file) {
   (void) fprintf(stderr,"ERROR: Can not open input file %s.\n",
    argv[in_fileP]);
   exit(1);
      }
  }

  (void) strcpy(input_score,"data/scores.19");
  (void) strcat(input_score,year);

if (preseason)
  (void) strcat(input_score,".pre");

  if (! (the_scores = fopen(input_score,"r"))) {
    int game,week;

    for (week=1;week<=num_games+1; week++)
      for (game=1;game<=28/2; game++) {
 scores[week][game][2] = -1;
 scores[week][game][1] = -1;
      }
    (void) fprintf(stderr,"No score file. Creating one.\n");
    save_scores (stdout,input_score);
    current_with_disk = 0;
  } else {
    int game,week;

    for (week=1;week<=num_games+1; week++)
      for (game=1;game<=28/2; game++) {
 if (feof(the_scores)) {
   (void) fprintf(stderr,"ERROR: %s is not a legally formated score file.\n",input_score);
   exit(1);
 }
 (void) fscanf(the_scores,"%d %d",&(scores[week][game][2]),
        &(scores[week][game][1]));
      }
    (void) fclose(the_scores);
    current_with_disk = 1;
  }
  compute_team_info ();
  sort_all ();

  while ( !terminate ) {
      if (in_fileP)
   display_main_menu(stdout,in_file);
      else display_main_menu(stdout,stdin);
  }
  if (in_fileP) (void) fclose(in_file);
  return 0;
}
