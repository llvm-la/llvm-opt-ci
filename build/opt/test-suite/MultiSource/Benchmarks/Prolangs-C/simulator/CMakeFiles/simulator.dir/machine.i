void RESET_DEVICES(void)
{
  int COUNT;

  DEVICE[0].STATUS = 0;
  DEVICE[0].STREAM = ((void*)0);
  DEVICE[128].STATUS = 0;
  DEVICE[128].STREAM = ((void*)0);
  for (COUNT = 0; COUNT < 256; COUNT ++) {
    if (DEVICE[COUNT].STATUS == 1)
      DEVICE[COUNT].STATUS = 0;
    if (DEVICE[COUNT].STREAM != ((void*)0)) {
      (void) fclose(DEVICE[COUNT].STREAM);
      DEVICE[COUNT].STREAM = ((void*)0);
    }
  }
}



