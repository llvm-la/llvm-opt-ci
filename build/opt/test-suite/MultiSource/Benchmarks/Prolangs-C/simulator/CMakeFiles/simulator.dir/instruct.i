  REGISTER[1] = REGISTER[1] - ((int) REGISTER[1] / 16777216) * 16777216;

  if (REGISTER[1] == 16777216 / 2) {
    SIGNAL_INTERUPT(2,04);
    if (PRINT_EFFECT) (void) printf("X has overflowed.\n");
    return;
  }

  if (REGISTER[1] >= 16777216 / 2) X_VAL = REGISTER[1] - 16777216;
  else X_VAL = REGISTER[1];

  if (VALUE >= 16777216 / 2) VALUE = VALUE - 16777216;

  if (X_VAL == VALUE) {
    SET_CC(0);
    if (PRINT_EFFECT) PRINT_CONSTANT("Set X to ",REGISTER[1]," and set CC to =.\n");
  }
  if (X_VAL < VALUE) {
    SET_CC(1);
    if (PRINT_EFFECT) PRINT_CONSTANT("Set X to ",REGISTER[1]," and set CC to <.\n");
  }
  if (X_VAL > VALUE) {
    SET_CC(2);
    if (PRINT_EFFECT) PRINT_CONSTANT("Set X to ",REGISTER[1]," and set CC to >.\n");
  }
}


void WD_P(BOOLEAN PRINT_EFFECT)
{
  int DEV;
  int VALUE;

  DEV = FORMAT3_4(1,1);
  if ((0 > DEV) || (DEV > 255)) {
    SIGNAL_INTERUPT(2,00);
    if (PRINT_EFFECT) (void) printf("WD illegal device.\n");
  } else {
    if ((DEVICE[DEV].STREAM == ((void*)0)) || (DEVICE[DEV].STATUS == 0)
 || (DEV < 128)) {
      SIGNAL_INTERUPT(2,00);
      if (PRINT_EFFECT) (void) printf("WD illegal device.\n");
    } else {
      VALUE = REGISTER[0] - ((int) REGISTER[0]/256)*256;
      (void) fprintf(DEVICE[DEV].STREAM,"%c",VALUE);
      if (PRINT_EFFECT) {
 PRINT_CONSTANT("Wrote ASCII char ",VALUE," to device ");
 PRINT_CONSTANT("",DEV,"\n");
      }
      DEVICE[DEV].STATUS = 0;
    }
  }
}
