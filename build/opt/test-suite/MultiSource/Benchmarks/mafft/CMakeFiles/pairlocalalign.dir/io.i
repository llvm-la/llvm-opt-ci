static void tabtospace( char *str )
{
 char *p;

 while( ((void*)0) != ( p = strchr( str , '\t' ) ) )
 {
  *p = ' ';
 }

}

static char *extractfirstword( char *str )
{
 char *val = str;

 tabtospace( str );
 while( *str )
 {
  if( val == str && *str == ' ' )
  {
   val++; str++;
  }
  else if( *str != ' ' )
  {
   str++;
  }
  else if( *str == ' ' )
  {
   *str = 0;
  }
 }
 return( val );
}


