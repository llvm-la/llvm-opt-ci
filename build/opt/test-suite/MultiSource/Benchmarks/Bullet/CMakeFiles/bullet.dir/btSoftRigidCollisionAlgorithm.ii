{
    if (a < b)
 {
  a = b;
 }
}

template <class T>
inline void GEN_clamp(T& a, const T& lb, const T& ub)
{
 if (a < lb)
 {
  a = lb;
 }
 else if (ub < a)
 {
  a = ub;
 }
}
