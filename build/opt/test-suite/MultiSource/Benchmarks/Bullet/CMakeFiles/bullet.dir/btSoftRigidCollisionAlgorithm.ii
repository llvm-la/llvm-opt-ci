template <class T>
inline const T& btMin(const T& a, const T& b)
{
  return a < b ? a : b ;
}

template <class T>
inline const T& btMax(const T& a, const T& b)
{
  return a > b ? a : b;
}

template <class T>
inline const T& GEN_clamped(const T& a, const T& lb, const T& ub)
{
 return a < lb ? lb : (ub < a ? ub : a);
}

