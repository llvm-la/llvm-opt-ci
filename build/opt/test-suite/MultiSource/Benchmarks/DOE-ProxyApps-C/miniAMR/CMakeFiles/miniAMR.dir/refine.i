      n = sorted_list[in].n;
      if ((bp= &blocks[n])->number >= 0)
         bp->refine = -1;
   }

   for (n = 0; n < max_active_parent; n++)
      if ((pp = &parents[n])->number >= 0) {
         pp->refine = -1;
         for (c = 0; c < 8; c++)
