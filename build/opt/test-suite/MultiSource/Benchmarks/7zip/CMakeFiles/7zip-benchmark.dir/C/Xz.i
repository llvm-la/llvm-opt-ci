}

unsigned XzFlags_GetCheckSize(CXzStreamFlags f)
{
  int t = ((f) & 0xF);
  return (t == 0) ? 0 : (4 << ((t - 1) / 3));
}

void XzCheck_Init(CXzCheck *p, int mode)
{
  p->mode = mode;
  switch (mode)
  {
    case 1: p->crc = 0xFFFFFFFF; break;
    case 4: p->crc64 = 0xFFFFFFFFFFFFFFFFULL; break;
    case 10: Sha256_Init(&p->sha); break;
  }
}

void XzCheck_Update(CXzCheck *p, const void *data, size_t size)
{
  switch (p->mode)
  {
    case 1: p->crc = CrcUpdate(p->crc, data, size); break;
    case 4: p->crc64 = Crc64Update(p->crc64, data, size); break;
    case 10: Sha256_Update(&p->sha, (const Byte *)data, size); break;
  }
}

int XzCheck_Final(CXzCheck *p, Byte *digest)
{
  switch (p->mode)
  {
    case 1:
      { UInt32 _x_ = (((p->crc) ^ 0xFFFFFFFF)); ((Byte *)(digest))[0] = (Byte)_x_; ((Byte *)(digest))[1] = (Byte)(_x_ >> 8); ((Byte *)(digest))[2] = (Byte)(_x_ >> 16); ((Byte *)(digest))[3] = (Byte)(_x_ >> 24); };
      break;
    case 4:
    {
      int i;
      UInt64 v = ((p->crc64) ^ 0xFFFFFFFFFFFFFFFFULL);
      for (i = 0; i < 8; i++, v >>= 8)
        digest[i] = (Byte)(v & 0xFF);
      break;
    }
    case 10:
      Sha256_Final(&p->sha, digest);
      break;
    default:
      return 0;
  }
  return 1;
}
