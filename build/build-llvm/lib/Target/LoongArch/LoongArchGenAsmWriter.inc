/// printInstruction - This method is automatically generated by tablegen
/// from the instruction set description.
LLVM_NO_PROFILE_INSTRUMENT_FUNCTION
void LoongArchInstPrinter::printInstruction(const MCInst *MI, uint64_t Address, const MCSubtargetInfo &STI, raw_ostream &O) {
  O << "\t";

  auto MnemonicInfo = getMnemonic(*MI);

  O << MnemonicInfo.first;

  uint32_t Bits = MnemonicInfo.second;
  assert(Bits != 0 && "Cannot print this instruction.");

  // Fragment 0 encoded into 2 bits for 4 unique commands.
  switch ((Bits >> 14) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // DBG_VALUE, DBG_VALUE_LIST, DBG_INSTR_REF, DBG_PHI, DBG_LABEL, BUNDLE, ...
    return;
    break;
  case 1:
    // PseudoAddTPRel_D, PseudoAddTPRel_W, PseudoCALL36, PseudoLA_ABS, Pseudo...
    printOperand(MI, 0, STI, O);
    break;
  case 2:
    // AMCAS_B, AMCAS_D, AMCAS_H, AMCAS_W, AMCAS__DB_B, AMCAS__DB_D, AMCAS__D...
    printOperand(MI, 1, STI, O);
    O << ", ";
    printOperand(MI, 2, STI, O);
    break;
  case 3:
    // INVTLB
    printOperand(MI, 2, STI, O);
    O << ", ";
    printOperand(MI, 1, STI, O);
    O << ", ";
    printOperand(MI, 0, STI, O);
    return;
    break;
  }


  // Fragment 1 encoded into 2 bits for 3 unique commands.
  switch ((Bits >> 16) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // PseudoAddTPRel_D, PseudoAddTPRel_W, PseudoLA_ABS, PseudoLA_ABS_LARGE, ...
    O << ", ";
    break;
  case 1:
    // PseudoCALL36, B, BL, BREAK, CSRWR, DBAR, DBCL, GCSRWR, HVCL, IBAR, IDL...
    return;
    break;
  case 2:
    // SET_CFR_FALSE, SET_CFR_TRUE
    O << ", $fa0, $fa0";
    return;
    break;
  }


  // Fragment 2 encoded into 2 bits for 4 unique commands.
  switch ((Bits >> 18) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // PseudoAddTPRel_D, PseudoAddTPRel_W, PseudoLA_ABS, PseudoLA_GOT, Pseudo...
    printOperand(MI, 1, STI, O);
    break;
  case 1:
    // PseudoLA_ABS_LARGE
    printOperand(MI, 2, STI, O);
    return;
    break;
  case 2:
    // AMCAS_B, AMCAS_D, AMCAS_H, AMCAS_W, AMCAS__DB_B, AMCAS__DB_D, AMCAS__D...
    printAtomicMemOp(MI, 3, STI, O);
    return;
    break;
  case 3:
    // BSTRINS_D, BSTRINS_W, CSRXCHG, GCSRXCHG, SC_D, SC_Q, SC_W, VBITSELI_B,...
    printOperand(MI, 3, STI, O);
    break;
  }


  // Fragment 3 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 20) & 1) {
    // PseudoLA_ABS, PseudoLA_GOT, PseudoLA_PCREL, PseudoLA_TLS_DESC, PseudoL...
    return;
  } else {
    // PseudoAddTPRel_D, PseudoAddTPRel_W, PseudoLA_GOT_LARGE, PseudoLA_PCREL...
    O << ", ";
  }


  // Fragment 4 encoded into 2 bits for 3 unique commands.
  switch ((Bits >> 21) & 3) {
  default: llvm_unreachable("Invalid command number.");
  case 0:
    // PseudoAddTPRel_D, PseudoAddTPRel_W, PseudoLA_GOT_LARGE, PseudoLA_PCREL...
    printOperand(MI, 2, STI, O);
    break;
  case 1:
    // AMADD_B, AMADD_D, AMADD_H, AMADD_W, AMADD__DB_B, AMADD__DB_D, AMADD__D...
    printAtomicMemOp(MI, 2, STI, O);
    return;
    break;
  case 2:
    // BSTRINS_D, BSTRINS_W
    printOperand(MI, 4, STI, O);
    return;
    break;
  }


  // Fragment 5 encoded into 1 bits for 2 unique commands.
  if ((Bits >> 23) & 1) {
    // PseudoLA_GOT_LARGE, PseudoLA_PCREL_LARGE, PseudoLA_TLS_DESC_LARGE, Pse...
    return;
  } else {
    // PseudoAddTPRel_D, PseudoAddTPRel_W, ALSL_D, ALSL_W, ALSL_WU, BSTRPICK_...
    O << ", ";
    printOperand(MI, 3, STI, O);
    return;
  }

