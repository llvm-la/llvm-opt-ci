  case 0: return (Subtarget->hasExtLASX());
  case 1: return (Subtarget->hasExtLASX()) && (Subtarget->is64Bit());
  case 2: return (Subtarget->hasExtLASX()) && !((Subtarget->is64Bit()));
  case 3: return (Subtarget->hasExtLSX());
  case 4: return (Subtarget->hasExtLSX()) && (Subtarget->is64Bit());
  case 5: return (Subtarget->hasExtLSX()) && !((Subtarget->is64Bit()));
  case 6: return (Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 7: return (Subtarget->is64Bit());
  case 8: return !((Subtarget->is64Bit()));
  case 9: return (Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 10: return (Subtarget->hasBasicF()) && (Subtarget->is64Bit());
  case 11: return (Subtarget->hasBasicF()) && !((Subtarget->is64Bit()));
  case 12: return (Subtarget->hasBasicD()) && (Subtarget->is64Bit());
  case 13: return (!Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 14: return (Subtarget->hasBasicD()) && !((Subtarget->is64Bit()));
  case 15: return (!Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 16: return (Subtarget->has32S()) && (!Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 17: return (Subtarget->hasBasicD());
  case 18: return (Subtarget->hasFrecipe());
  case 19: return (Subtarget->hasBasicF());
  case 20: return (Subtarget->has32S()) && (!Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 21: return (Subtarget->hasLAM_BH()) && (Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 22: return (Subtarget->hasLAM_BH()) && (Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 23: return (Subtarget->hasBasicD()) && (Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 24: return (Subtarget->hasLAMCAS()) && (Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 25: return (Subtarget->hasLAMCAS()) && (Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 26: return (Subtarget->has32S()) && (Subtarget->is64Bit());
  case 27: return (Subtarget->has32S()) && !((Subtarget->is64Bit()));
  case 28: return (Subtarget->hasBasicD()) && (Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 29: return (Subtarget->hasBasicD()) && (!Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 30: return (Subtarget->hasBasicF()) && (Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 31: return (Subtarget->hasBasicF()) && (!Subtarget->is64Bit()) && !((Subtarget->is64Bit()));
  case 32: return (Subtarget->hasBasicD()) && (!Subtarget->is64Bit()) && (Subtarget->is64Bit());
  case 33: return (!Subtarget->is64Bit());
